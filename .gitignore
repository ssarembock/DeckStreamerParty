# Unity-generated folders (rebuilt automatically when the project is opened)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Game builds (make builds into Builds/, see V1Instructions.md section 6B)
/[Bb]uild/
/[Bb]uilds/
/FirstTest/
*_BurstDebugInformation_DoNotShip/

# IDE files, regenerated by Unity
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash and export leftovers
sysinfo.txt
mono_crash.*
*.tmp
*.unitypackage
# ...and their .meta files (Unity deletes them on a PC that does not have the package, then they flip-flop).
*.unitypackage.meta
*.apk
*.aab
crashlytics-build.properties
ExportedObj/
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Personal Claude Code permissions (shared ones are in .claude/settings.json)
.claude/settings.local.json

# Claude compile-check output (.claude/tools/compile) and raw transcripts (only the gzipped copies are shared)
.claude/tools/compile/out/
.claude/tools/compile/**/obj/
.claude/tools/compile/**/bin/
.claude/sessions/*.jsonl
# ...but the compile check's own project files are shared (Unity's generated *.csproj above stay ignored).
!.claude/tools/compile/**/*.csproj

# Steam: written from Project Settings > Deck Party > Online Platform (App ID); each PC regenerates it
/steam_appid.txt
