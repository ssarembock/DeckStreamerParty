<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DeckParty.Editor</AssemblyName>
    <DefineConstants>$(DefineConstants);$(ExtraDefines)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectRoot)\Assets\DeckParty\Scripts\Editor\**\*.cs" />
    <Compile Include="$(EditorStubs)" Condition="'$(EditorStubs)' != ''" />
    <Reference Include="$(OutDirShared)DeckParty.Core.dll" Private="false" />
    <Reference Include="$(OutDirShared)DeckParty.Runtime.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.Netcode.Runtime.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.Networking.Transport.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>
</Project>
