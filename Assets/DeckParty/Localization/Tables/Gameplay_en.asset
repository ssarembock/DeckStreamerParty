    m_Localized: Pick {0} to {1} viewers.
    m_Metadata:
      m_Items: []
  - m_Id: 483606603
    m_Localized: That's not a valid choice.
    m_Metadata:
      m_Items: []
  - m_Id: 483606604
    m_Localized: You can only recruit between streams.
    m_Metadata:
      m_Items: []
