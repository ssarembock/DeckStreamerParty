    m_Metadata:
      m_Items: []
  - m_Id: 483606592
    m_Localized: That would bring the SWAT team.
    m_Metadata:
      m_Items: []
  - m_Id: 483606593
    m_Localized: No viewer can be chosen right now.
    m_Metadata:
      m_Items: []
  - m_Id: 483606594
    m_Localized: Needs {0} viewers that can be chosen.
    m_Metadata:
      m_Items: []
  - m_Id: 483606595
    m_Localized: Pick one of the options.
    m_Metadata:
      m_Items: []
  - m_Id: 483606596
    m_Localized: Needs {0} {icon:subs}.
    m_Metadata:
      m_Items: []
  - m_Id: 483606597
    m_Localized: Needs {0} {icon:cash}.
    m_Metadata:
      m_Items: []
  - m_Id: 483606598
    m_Localized: There's no random arrival to reroll.
    m_Metadata:
      m_Items: []
  - m_Id: 483606599
    m_Localized: Pick one of the next viewers to deny.
    m_Metadata:
      m_Items: []
  - m_Id: 483606600
    m_Localized: Pick who comes in next.
    m_Metadata:
      m_Items: []
