  m_Name: Content_es-419
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: fe08c675884f17142aef311dafa6f47f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 370360320
    m_Localized: Primer stream
    m_Metadata:
      m_Items: []
  - m_Id: 433274880
    m_Localized: "Aprende lo b\xE1sico"
    m_Metadata:
      m_Items: []
  - m_Id: 433274881
    m_Localized: Tu primera temporada en vivo. Habituales confiables, Productor y
      Admin del chat para manejar la sala, un colaborador riesgoso y tres Plays amigables.
    m_Metadata:
      m_Items: []
  - m_Id: 433274882
    m_Localized: Club de fans
    m_Metadata:
      m_Items: []
  - m_Id: 433274883
    m_Localized: La lealtad paga
    m_Metadata:
      m_Items: []
  - m_Id: 433274884
    m_Localized: "Arma un verdadero {icon:CoreFanbase} N\xFAcleo de fans: cada tres
      habituales distintos anulan 1 {icon:risk}, as\xED que los trolls y los orbitadores
      se vuelven dinero seguro. Conejo maratonero y Usuario de cupones aman el chat
      lleno."
    m_Metadata:
      m_Items: []
  - m_Id: 433274885
    m_Localized: Momento viral
    m_Metadata:
      m_Items: []
  - m_Id: 433274886
    m_Localized: A la caza de fama
    m_Metadata:
      m_Items: []
  - m_Id: 433274887
    m_Localized: "Colaboradores, esc\xE1ndalos y celebridades. {icon:Content} Contenido
      hace que los espectadores fuera de tu n\xFAcleo punt\xFAen dos veces y {icon:Clout}
      Fama les suma {icon:subs} extra, pero el riesgo se acumula r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 433274888
    m_Localized: Laboratorio de memes
    m_Metadata:
      m_Items: []
  - m_Id: 433274889
    m_Localized: Tanta sinergia
    m_Metadata:
      m_Items: []
  - m_Id: 433274890
    m_Localized: "La {icon:MemeticsDivision} Divisi\xF3n Mem\xE9tica puede hacer
      que todo el stream punt\xFAe dos veces. Perro Degen quiere un chat lleno de
      comunidades distintas y Gato Desconsolado gana cada vez que echan a alguien."
    m_Metadata:
      m_Items: []
  - m_Id: 433274891
    m_Localized: "Reuni\xF3n de equipo"
    m_Metadata:
      m_Items: []
  - m_Id: 433274892
    m_Localized: Todo bajo control
    m_Metadata:
      m_Items: []
  - m_Id: 433274893
    m_Localized: "Todo el equipo en n\xF3mina. {icon:Staff} Staff puede perdonar
      sus propios costos de {icon:cash}, {icon:Techspertise} Tecnoexpertos puede
      revivir un servidor ca\xEDdo y cada acci\xF3n hace entrar al espectador correcto
      o sacar al equivocado."
    m_Metadata:
      m_Items: []
  - m_Id: 433274894
    m_Localized: Mezcla al azar
    m_Metadata:
      m_Items: []
  - m_Id: 433274895
    m_Localized: Un elenco nuevo cada vez
    m_Metadata:
      m_Items: []
  - m_Id: 433274896
    m_Localized: Once espectadores al azar y tres Plays al azar. Gana cinco seguidas
      para conseguir la Cereza.
    m_Metadata:
      m_Items: []
  - m_Id: 433274897
    m_Localized: Lobby abierto
    m_Metadata:
      m_Items: []
  - m_Id: 433274898
    m_Localized: Todos son bienvenidos (sandbox)
    m_Metadata:
      m_Items: []
  - m_Id: 433274899
    m_Localized: "Todos los espectadores reclutables est\xE1n en la tienda. Ideal
      para experimentar; no cuenta para el progreso."
    m_Metadata:
      m_Items: []
  - m_Id: 433274900
    m_Localized: "Setup en la habitaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 433274901
    m_Localized: "Tiras RGB, un aro de luz y una cama que definitivamente sale en
      c\xE1mara."
    m_Metadata:
      m_Items: []
  - m_Id: 433274902
    m_Localized: Stream IRL en la playa
    m_Metadata:
      m_Items: []
  - m_Id: 433274903
    m_Localized: Atardecer, gaviotas y un celular en un palo de selfie.
    m_Metadata:
      m_Items: []
  - m_Id: 433274904
    m_Localized: "Ciudad Ne\xF3n IRL"
    m_Metadata:
      m_Items: []
  - m_Id: 433274905
    m_Localized: "Transmitiendo desde una azotea. El horizonte brilla. El chat tambi\xE9n."
    m_Metadata:
      m_Items: []
  - m_Id: 433274906
    m_Localized: Casa de creadores
    m_Metadata:
      m_Items: []
  - m_Id: 433274907
    m_Localized: Diez creadores, una cocina, cero privacidad.
    m_Metadata:
      m_Items: []
  - m_Id: 433274908
    m_Localized: Stream maldito de las 3 a. m.
    m_Metadata:
      m_Items: []
  - m_Id: 433274909
    m_Localized: "No leas el chat. No mires atr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 433274910
    m_Localized: Lounge del Metaverso
    m_Metadata:
      m_Items: []
  - m_Id: 433274911
    m_Localized: Todos son torsos flotantes. Nadie tiene piernas.
    m_Metadata:
      m_Items: []
  - m_Id: 433274912
    m_Localized: Escenario de estudio
    m_Metadata:
      m_Items: []
  - m_Id: 433274913
    m_Localized: "Pantalla verde, m\xE1quina de humo, clips legendarios."
    m_Metadata:
      m_Items: []
  - m_Id: 433274914
    m_Localized: "B\xFAnker del Debate"
    m_Metadata:
      m_Items: []
  - m_Id: 433274915
    m_Localized: "Tres monitores, dos discusiones y un micr\xF3fono muy fuerte."
    m_Metadata:
      m_Items: []
  - m_Id: 433274916
    m_Localized: Estudio de Podcast
    m_Metadata:
      m_Items: []
  - m_Id: 433274917
    m_Localized: "Paneles de madera, letrero de ne\xF3n, cecina de alce. Episodio
      cuatrocientos veinte."
    m_Metadata:
      m_Items: []
  - m_Id: 433274918
    m_Localized: Dojo del Pro Gamer
    m_Metadata:
      m_Items: []
  - m_Id: 433274919
    m_Localized: "LEDs azules, un refrigerador de bebidas energ\xE9ticas y una bandana
      en un pedestal."
    m_Metadata:
      m_Items: []
  - m_Id: 433274920
    m_Localized: Cuarto de los Gritos
    m_Metadata:
      m_Items: []
  - m_Id: 433274921
    m_Localized: "Espuma ac\xFAstica, una pelota de f\xFAtbol y algo en llamas."
    m_Metadata:
      m_Items: []
  - m_Id: 433274922
    m_Localized: Bodega de Sorteos
    m_Metadata:
      m_Items: []
  - m_Id: 433274923
    m_Localized: Pallets de billetes, un reloj de cuenta regresiva y muchos concursantes
      muy nerviosos.
    m_Metadata:
      m_Items: []
  - m_Id: 433274924
    m_Localized: "La Mansi\xF3n (edici\xF3n socialista)"
    m_Metadata:
      m_Items: []
  - m_Id: 433274925
    m_Localized: "Una sala de dos millones de d\xF3lares con un coj\xEDn de la hoz
      y el martillo."
    m_Metadata:
      m_Items: []
  - m_Id: 433274926
    m_Localized: Gimnasio de los Sentimientos
    m_Metadata:
      m_Items: []
  - m_Id: 433274927
    m_Localized: "Mancuernas, una bolsa de boxeo y una caja de pa\xF1uelos. Para
      la bolsa."
    m_Metadata:
      m_Items: []
  - m_Id: 433274928
    m_Localized: Arena del Tablero
    m_Metadata:
      m_Items: []
  - m_Id: 433274929
    m_Localized: Sesenta y cuatro casillas, dos cabezas y cero voz baja.
    m_Metadata:
      m_Items: []
  - m_Id: 433274930
    m_Localized: Pradera Pal
    m_Metadata:
      m_Items: []
  - m_Id: 433274931
    m_Localized: Colinas pastel, criaturas esponjosas y una cantidad sospechosa de
      esferas de captura.
    m_Metadata:
      m_Items: []
  - m_Id: 433274932
    m_Localized: "Vac\xEDo del Pizarr\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 433274933
    m_Localized: Un lienzo oscuro infinito donde los vectores giran suavemente.
    m_Metadata:
      m_Items: []
  - m_Id: 433274934
    m_Localized: Arena del Club de Campeones
    m_Metadata:
      m_Items: []
  - m_Id: 433274935
    m_Localized: "Humo, l\xE1seres, un negatoscopio con radiograf\xEDas y un trofeo
      enorme."
    m_Metadata:
      m_Items: []
  - m_Id: 416590601601024
    m_Localized: Brecha generacional
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904192
    m_Localized: OK boomer
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904193
    m_Localized: '{icon:Boomer} Boomer paga en {icon:cash}, {icon:Millennial} Millennial
      en {icon:subs} y {icon:Zoomer} Zoomer tira los dados. Maestro de la moneda
      y Director de PR sacan provecho de cada espectador riesgoso del chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904194
    m_Localized: Invierno cripto
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904195
    m_Localized: Cobra antes de que se caiga
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904196
    m_Localized: "{icon:FinanceBros} Finance Bros puede duplicar cada recompensa
      de {icon:cash}. Haz un rug pull con el Entusiasta cripto, acumula c\xF3digos,
      haz crecer a tu Centennial con trabajo y deja que el Esc\xE1ndalo en l\xEDnea
      llene la sala."
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904197
    m_Localized: "Secci\xF3n de comentarios"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904198
    m_Localized: No alimentes a los trolls
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904199
    m_Localized: "{icon:Trolls} Trolls paga aunque te desplataformen. Juega con el
      riesgo con el \xC1rbitro del chat listo y, en multijugador, deja que los {icon:Bots}
      Bots de Clippo el Chatarra spameen al siguiente streamer."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
