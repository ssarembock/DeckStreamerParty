    m_Localized: "\u0421\u043B\u043E\u0436\u043D\u043E ({seconds} \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 437469207
    m_Localized: "\u0421\u0440\u0435\u0434\u043D\u0435 ({seconds} \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 437469208
    m_Localized: "\u041B\u0435\u0433\u043A\u043E ({seconds} \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 437469209
    m_Localized: "\u0421\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 437469210
    m_Localized: "{seconds} \u0441 \u043D\u0430 \u0441\u0442\u0440\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 437469211
    m_Localized: "\u0423\u0436\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u0435\u043C\u0441\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 437469212
    m_Localized: "\u0412\u044B \u0443\u0436\u0435 \u0432 \u0438\u0433\u0440\u0435.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0439\u0434\u0438\u0442\u0435
      \u0438\u0437 \u043D\u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 437469213
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0430\u044F \u0441\u0435\u0441\u0441\u0438\u044F
      \u0435\u0449\u0451 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 437469214
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443 \u043D\u0430 \u043F\u043E\u0440\u0442\u0443 {0}. \u041C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C, \u0443\u0436\u0435 \u0437\u0430\u043F\u0443\u0449\u0435\u043D\u0430
      \u0434\u0440\u0443\u0433\u0430\u044F \u043A\u043E\u043F\u0438\u044F \u0438\u0433\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 437469215
    m_Localized: "\xAB{0}\xBB \u2014 \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      IP-\u0430\u0434\u0440\u0435\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 437469216
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0441\u0435\u0442\u0435\u0432\u043E\u0439 \u043A\u043B\u0438\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 437469217
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443 \u0447\u0435\u0440\u0435\u0437 Relay."
    m_Metadata:
      m_Items: []
  - m_Id: 437469218
    m_Localized: "\u0414\u043B\u044F \u043E\u043D\u043B\u0430\u0439\u043D-\u0438\u0433\u0440\u044B
      \u043D\u0443\u0436\u0435\u043D \u043F\u0430\u043A\u0435\u0442 Multiplayer Services
      (com.unity.services.multiplayer)."
    m_Metadata:
      m_Items: []
  - m_Id: 437469219
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u043E\u0434,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0441\u044F
      \u0445\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 437469220
    m_Localized: "\u041E\u043D\u043B\u0430\u0439\u043D-\u0438\u0433\u0440\u0430 \u0435\u0449\u0451
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0430: \u043F\u0440\u0438\u0432\u044F\u0436\u0438\u0442\u0435
      \u043F\u0440\u043E\u0435\u043A\u0442 \u043A Unity Cloud \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      Relay (\u0441\u043C. INSTRUCTIONS.md) \u0438\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043F\u0440\u044F\u043C\u043E\u0439 IP."
    m_Metadata:
      m_Items: []
  - m_Id: 437469221
    m_Localized: "\u0418\u0433\u0440\u0430 \u0441 \u0442\u0430\u043A\u0438\u043C
      \u043A\u043E\u0434\u043E\u043C \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u0430.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043A\u043E\u0434 \u0438
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 437469222
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043C\u0438 Unity. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 437469223
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u043E\u043D\u043B\u0430\u0439\u043D-\u0438\u0433\u0440\u0443: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 437469224
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 437469225
    m_Localized: "\u0425\u043E\u0441\u0442 \u0437\u0430\u043A\u0440\u044B\u043B \u043B\u043E\u0431\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 437469226
    m_Localized: "\u0412\u0435\u0440\u0441\u0438\u0438 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442:
      \u0443 \u0432\u0441\u0435\u0445 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
      \u043E\u0434\u043D\u0430 \u0438 \u0442\u0430 \u0436\u0435 \u0441\u0431\u043E\u0440\u043A\u0430
      \xAB\u0411\u0438\u0442\u0432\u044B \u0437\u0430 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 437469227
    m_Localized: "\u042D\u0442\u0430 \u0438\u0433\u0440\u0430 \u0443\u0436\u0435
      \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 437469228
    m_Localized: "\u042D\u0442\u0430 \u0438\u0433\u0440\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430
      ({0} \u0438\u0433\u0440\u043E\u043A\u043E\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 437469229
    m_Localized: "\u0421\u0435\u0442\u0435\u0432\u043E\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 437469230
    m_Localized: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0441 \u0445\u043E\u0441\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 437469231
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043A\u043E\u0434 \u0438\u043B\u0438
      \u0430\u0434\u0440\u0435\u0441 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 437469232
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u043C\u043E\u0436\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 437469233
    m_Localized: "\u041C\u0430\u0442\u0447 \u0443\u0436\u0435 \u043D\u0430\u0447\u0430\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 437469234
    m_Localized: "\u0416\u0434\u0451\u043C, \u043F\u043E\u043A\u0430 {0} {0:plural:\u0438\u0433\u0440\u043E\u043A|\u0438\u0433\u0440\u043E\u043A\u0430|\u0438\u0433\u0440\u043E\u043A\u043E\u0432}
      \u0431\u0443\u0434\u0443\u0442 \u0433\u043E\u0442\u043E\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 437469235
    m_Localized: "\u0421\u0435\u0437\u043E\u043D \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F:
      \xAB{0}\xBB, \u043D\u043E\u0447\u0435\u0439: {1}. \u041F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u0442\u0440\u0438\u043C \u0441
      {2} \u0442\u0440\u043E\u0444\u0435\u044F\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 437469236
    m_Localized: "\u0412\u0430\u0448 \u0445\u043E\u0434 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 437469237
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0445\u043E\u0434\u0438\u0442
      {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 437469238
    m_Localized: "\u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0441\u0432\u043E\u0435\u0433\u043E
      \u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 437469239
    m_Localized: "\u0412\u044B \u043E\u0442\u043C\u0435\u0442\u0438\u043B\u0438\u0441\u044C
      \u043A\u0430\u043A \u0433\u043E\u0442\u043E\u0432\u044B\u0439. \u041E\u0442\u043C\u0435\u043D\u0438\u0442\u0435
      \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u043E\u043A\u0443\u043F\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 437469240
    m_Localized: "{0} \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F
