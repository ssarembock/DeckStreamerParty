    m_Localized: "{icon:plays} \u041F\u0440\u043E\u0434\u0430\u043A\u0442-\u043F\u043B\u0435\u0439\u0441\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262499
    m_Localized: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u044B\u0439 \u0433\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262500
    m_Localized: "\u0410\u041B\u041C\u0410\u0417. \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435:
      \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0433\u043E
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u0438\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u0438,
      \u0434\u0430\u0436\u0435 \u0434\u0440\u0443\u0433\u043E\u0439 \u0430\u043B\u043C\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262501
    m_Localized: "\u0414\u0432\u0430 \u043F\u043E \u0446\u0435\u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262502
    m_Localized: "\u0412\u043B\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0442\u0440\u043E\u043B\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262503
    m_Localized: "\u041C\u043D\u043E\u0433\u043E {icon:subs}, \u043D\u043E \u0437\u0430
      \u043D\u0438\u043C \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262504
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442 \u043F\u043E
      \u043A\u0438\u0431\u0435\u0440\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262505
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0438 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0435\u0433\u043E \u0438\u043B\u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0441\u0442\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262506
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F \u043D\u0430 \u0447\u0442\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262507
    m_Localized: "\u041F\u043B\u0430\u0442\u043D\u0430\u044F \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262508
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E \u043F\u043B\u0430\u0442\u0438\u0442,
      \u043D\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443: -1 {icon:subs} \u043F\u0440\u0438
      \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262509
    m_Localized: "\u041A\u043E\u043C\u0438\u043A \u0441 \u043F\u043E\u0434\u043A\u0430\u0441\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262510
    m_Localized: "+5 {icon:subs}, \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0435\u0441\u043B\u0438 \u043F\u0440\u0438 \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435
      \u0447\u0430\u0442 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D. \u0412\u0441\u0435\u0433\u0434\u0430
      \u0441\u0442\u043E\u0438\u0442 1 {icon:cash}."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262511
    m_Localized: "\u0410\u043A\u043A\u0430\u0443\u043D\u0442-\u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262512
    m_Localized: "\u041C\u043D\u043E\u0433\u043E {icon:subs}, \u043D\u043E \u0436\u0434\u0451\u0442
      \u043E\u043F\u043B\u0430\u0442\u044B: \u043F\u0440\u0438 \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435
      \u0441\u0442\u043E\u0438\u0442 1 {icon:cash}."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262513
    m_Localized: "\u041A\u0440\u0438\u043F\u0442\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262514
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u0432 \u0447\u0430\u0442\u0435,
      \u0441\u043E \u0448\u0442\u0440\u0430\u0444\u0430\u043C\u0438 (\u0441\u0440\u0430\u0437\u0443
      \u043D\u0430 \u0441\u0447\u0451\u0442). \u0412 \u043A\u043E\u043D\u0446\u0435
      \u0441\u0442\u0440\u0438\u043C\u0430 \u043E\u043D \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262515
    m_Localized: "\u0420\u0430\u0433\u043F\u0443\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262516
    m_Localized: "\u0429\u0435\u0434\u0440\u044B\u0439 \u0434\u043E\u043D\u0430\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262517
    m_Localized: "\u041E\u0442\u0434\u0430\u0439 \u0431\u043E\u0433\u0430\u0442\u044B\u043C!:
      \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0435 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0438\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0438 \u0441\u0440\u0430\u0437\u0443
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u0435\u0433\u043E (\u043D\u0430 \u0441\u0447\u0451\u0442)."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262518
    m_Localized: "PR-\u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262519
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0432\u0441\u0435\u0445 \u0438\u0437 \u0447\u0430\u0442\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u0437\u0430\u0448\u043B\u0438 \u0441\u043D\u043E\u0432\u0430.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262520
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0443\u0449\u0435\u0440\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262521
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043A\u043E\u043B\u043B\u0430\u0431\u043E\u0440\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262522
    m_Localized: "#\u0418\u041E\u043D\u0422\u043E\u0436\u0435?: \u0431\u043E\u043B\u044C\u0448\u0438\u0435
      {icon:cash}, \u0431\u043E\u043B\u044C\u0448\u043E\u0439 {icon:risk}."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262523
    m_Localized: "\u0410\u0440\u0431\u0438\u0442\u0440 \u0447\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262524
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u0441\u043D\u044F\u0442\u044C
      {icon:risk} \u0441\u043E \u0432\u0441\u0435\u0445 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
      \u0441 {icon:risk} \u0432 \u0447\u0430\u0442\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0442\u0440\u0438\u043C\u0430, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u043E\u043D\u0438 \u0443\u0439\u0434\u0443\u0442 \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262525
    m_Localized: "\u041C\u0438\u0440 \u0432 \u0447\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262526
    m_Localized: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440 \u0431\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262527
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u0434\u0432\u0443\u0445 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
      \u0432 \u0447\u0430\u0442\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0442\u0440\u0438\u043C\u0430 (\u0434\u0435\u0442\u0435\u043A\u0442\u043E\u0440
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043E\u0434\u043D\u0438\u043C
      \u0438\u0437 \u043D\u0438\u0445)."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262528
    m_Localized: "\u0427\u0438\u0441\u0442\u043A\u0430 \u0431\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262529
    m_Localized: "\u0420\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043E\u0440\u0431\u0438\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262530
    m_Localized: "\u041F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 {icon:subs} \u0438
      {icon:cash}, \u0430 \u0441 \u043D\u0438\u043C\u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      {icon:risk}."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262531
    m_Localized: "\u041C\u0435\u0446\u0435\u043D\u0430\u0442-\u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262532
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 (\u0440\u0430\u0437
      \u0437\u0430 \u0441\u0442\u0440\u0438\u043C \u043D\u0430 \u0432\u0441\u0435\u0445):
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
      \u0432 \u0447\u0430\u0442\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 0 {icon:subs}, \u0430 \u0432\u044B
      \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      1 {icon:cash} \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043C\u0435\u0446\u0435\u043D\u0430\u0442\u0430-\u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u0435\u0440\u0430
      \u0432 \u0447\u0430\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262533
    m_Localized: "\u0423\u0434\u043E\u0431\u043D\u043E\u0435 \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262534
    m_Localized: "\u0422\u0435\u0445\u0430\u0434\u043C\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262535
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0441\u0442\u0440\u0438\u043C\u0430
      (\u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u043E\u0433\u043E \u0442\u0435\u0445\u0430\u0434\u043C\u0438\u043D\u0430)."
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262536
    m_Localized: "\u041F\u0440\u0430\u0432\u0430 \u0430\u0434\u043C\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262537
    m_Localized: "\u041E\u043D\u043B\u0430\u0439\u043D-\u0441\u043A\u0430\u043D\u0434\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262538
    m_Localized: "\u041D\u0435\u0437\u0432\u0430\u043D\u044B\u0435 \u0433\u043E\u0441\u0442\u0438:
      \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0435 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
      \u0434\u0432\u0443\u0445 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439. \u041C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0447\u0430\u0442 \u0437\u0430
      \u043B\u0438\u043C\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 416591591456768
    m_Localized: "\u041F\u0440\u0438\u0432\u0440\u0430\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 416591591456769
    m_Localized: "\u0422\u044B \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C!:
