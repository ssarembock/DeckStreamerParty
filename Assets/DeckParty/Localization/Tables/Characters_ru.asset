  m_TableData:
  - m_Id: 433274880
    m_Localized: "\u0412\u0435\u0440\u043D\u044B\u0439 \u0444\u0430\u043D\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 500383744
    m_Localized: "\u0411\u0430\u0437\u043E\u0432\u044B\u0439 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C. \u0412\u0441\u0435\u0433\u0434\u0430
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 500383745
    m_Localized: "\u041A\u0438\u0442-\u0434\u043E\u043D\u0430\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 500383746
    m_Localized: "\u0411\u0430\u0437\u043E\u0432\u044B\u0439 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C, \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u043F\u0435\u0440\u0432\u044B\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
      \u043B\u0438\u043C\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 500383747
    m_Localized: "\u0411\u043E\u0442\u043E\u0444\u0435\u0440\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 500383748
    m_Localized: "\u0414\u0435\u0448\u0451\u0432\u044B\u0435 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u044B,
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 500383749
    m_Localized: "SMM-\u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 500383750
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0438 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0435\u0433\u043E \u0438\u043B\u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0441\u0442\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 500383751
    m_Localized: "\u0421\u043F\u043E\u0439\u043B\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 500383752
    m_Localized: "\u041C\u043E\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 500383753
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u0432\u044B\u0433\u043D\u0430\u0442\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0438\u0437 \u0447\u0430\u0442\u0430 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0442\u0440\u0438\u043C\u0430 (\u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u043E\u0433\u043E
      \u043C\u043E\u0434\u0435\u0440\u0430)."
    m_Metadata:
      m_Items: []
  - m_Id: 500383754
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0438\u0437 \u0447\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 500383755
    m_Localized: "\u0410\u0432\u0442\u043E\u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 500383756
    m_Localized: "\u041F\u043E\u043A\u0430 \u0432 \u0447\u0430\u0442\u0435, \u0433\u0430\u0441\u0438\u0442
      1 \u0440\u0438\u0441\u043A \u043F\u043E\u043B\u0438\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 500383757
    m_Localized: "\u041A\u043E\u043B\u043B\u0430\u0431\u043E\u0440\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 500383758
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0438\u0435 \u0446\u0438\u0444\u0440\u044B,
      \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0438\u0439 \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 500383759
    m_Localized: "\u0425\u041E\u0414\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 500383760
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0432\u0441\u0435\u0445 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u0437\u0430\u0448\u043B\u0438 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 500383761
    m_Localized: "\u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A \u0441\u0442\u0440\u0438\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 500383762
    m_Localized: "\u0412\u0418\u041F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 500383763
    m_Localized: "\u041F\u043E\u043A\u0430 \u0432 \u0447\u0430\u0442\u0435, \u0433\u0430\u0441\u0438\u0442
      1 \u0440\u0438\u0441\u043A \u043F\u043E\u043B\u0438\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 500383764
    m_Localized: "\u041F\u0430\u0440\u0430\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 500383765
    m_Localized: "\u041F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u0441 \u0441\u043E\u0431\u043E\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 500383766
    m_Localized: "\u0414\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 500383767
    m_Localized: "\u0422\u0430\u043A\u0430\u044F \u0441\u0438\u043D\u0435\u0440\u0433\u0438\u044F:
      +1 {icon:subs} \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u0440\u0430\u0437\u043D\u043E\u0435
      \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \u0432 \u0447\u0430\u0442\u0435
      (\u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C +5). \u0414\u0440\u0443\u0433\u0438\u0435
      \u0414\u043E\u0433\u0435 \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 500383768
    m_Localized: "\u0422\u0440\u043E\u043B\u043B\u0444\u0435\u0439\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 500383769
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u044C (\u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u043D \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F).
      +2 {icon:subs} \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437,
      \u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0442\u0440\u043E\u043B\u043B\u0438\u043B\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u044D\u0442\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 500383770
    m_Localized: "\u0427\u0451, \u0431\u043E\u043C\u0431\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 500383771
    m_Localized: "\u041F\u0435\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 500383772
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      \u0420\u0430\u0434\u043E\u0441\u0442\u044C (+3 {icon:subs}), \u0413\u0440\u0443\u0441\u0442\u044C
      (+3 {icon:cash}) \u0438\u043B\u0438 \u042F\u0440\u043E\u0441\u0442\u044C (+6
      {icon:subs} \u0438 +1 {icon:risk}) \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0442\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 500383773
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0430\u0434\u044B \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 500383774
    m_Localized: "\u0413\u0438\u0433\u0430\u0447\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 500383775
    m_Localized: "\u0410\u043B\u044C\u0444\u0430-\u044D\u043D\u0435\u0440\u0433\u0438\u044F:
      +3 {icon:subs}, \u0435\u0441\u043B\u0438 \u043E\u043D \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0441 5+ \u0431\u0430\u0437\u043E\u0432\u044B\u043C\u0438
      {icon:subs}. \u041A\u0430\u0436\u0434\u044B\u0439 \u043B\u0438\u0448\u043D\u0438\u0439
      \u0413\u0438\u0433\u0430\u0447\u0430\u0434 \u0434\u0430\u0451\u0442 \u0432\u0441\u0435\u043C
      \u0413\u0438\u0433\u0430\u0447\u0430\u0434\u0430\u043C -2 {icon:subs}."
    m_Metadata:
      m_Items: []
  - m_Id: 500383776
    m_Localized: "\u041F\u0451\u0441 \xAB\u0412\u0441\u0451 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 500383777
    m_Localized: "\u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435: \u043A\u043E\u0433\u0434\u0430
      {icon:risk} \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0434\u043E\u0441\u0442\u0438\u0447\u044C 3, \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433
      \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0438 \u0432\u0435\u0441\u044C
      {icon:risk} \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0417\u0430\u0442\u0435\u043C \u044D\u0442\u0430 \u043A\u043E\u043F\u0438\u044F
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 500383778
    m_Localized: "\u0412\u043E\u0434\u0436\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 500383779
    m_Localized: "\u041E\u0431\u0449\u0438\u0435 \u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044F:
      +2 {icon:subs} \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0449\u0435\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      ({icon:risk}, \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0441\u0442\u0430\u0442\u044B, \u0437\u0430\u0440\u0430\u0436\u0451\u043D,
      \u043E\u0431\u043D\u0443\u043B\u0451\u043D \u0438\u043B\u0438 \u043D\u0430\u043A\u0430\u0437\u0430\u043D),
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C +6."
    m_Metadata:
      m_Items: []
  - m_Id: 504578048
    m_Localized: "\u0421\u0435\u0440\u0434\u0438\u0442\u044B\u0439 \u043A\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 504578049
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 3 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438. \u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      \u043E\u0434\u043D\u043E\u043C\u0443 \u043D\u0430 \u044D\u0442\u0443 \u043D\u043E\u0447\u044C
      \u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C, \u043A\u0442\u043E \u0432\u043E\u0439\u0434\u0451\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 504578050
    m_Localized: "\u041D\u0438 \u0437\u0430 \u0447\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 504578051
    m_Localized: "\u041D\u044F\u043D-\u043A\u044D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 504578052
    m_Localized: "\u0420\u0430\u0434\u0443\u0436\u043D\u044B\u0439 \u0441\u043B\u0435\u0434:
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
      \u0431\u0435\u0437 {icon:risk}, \u0437\u0430\u0448\u0435\u0434\u0448\u0438\u0439
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0451 \u043F\u043E\u0434\u0440\u044F\u0434,
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 +1, +2, +3... {icon:subs}
      (\u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C +6). \u0417\u0440\u0438\u0442\u0435\u043B\u044C
      \u0441 {icon:risk} \u0440\u0432\u0451\u0442 \u0446\u0435\u043F\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 504578053
    m_Localized: "\u0421\u0442\u043E\u043D\u043A\u0441-\u043C\u044D\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 504578054
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435: \u0432\u043B\u043E\u0436\u0438\u0442\u044C
      2 {icon:subs} \u0438\u043B\u0438 1 {icon:cash}. \u0415\u0441\u043B\u0438 \u0441\u0442\u0440\u0438\u043C
      \u0443\u0434\u0430\u043B\u0441\u044F \u2014 \u0432\u0442\u0440\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0435\u0441\u043B\u0438 \u043D\u0435\u0442
      \u2014 \u0432\u0441\u0451 \u043F\u0440\u043E\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 504578055
    m_Localized: "\u041C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u044F
      \u0440\u044B\u043D\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 504578056
    m_Localized: "\u0427\u0438\u043C\u0441"
    m_Metadata:
