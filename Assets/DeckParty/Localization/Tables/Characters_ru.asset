      m_Items: []
  - m_Id: 504578081
    m_Localized: "\u041D\u0430\u0432\u0435\u043A\u0438 \u0442\u0432\u043E\u044F:
      \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0435 \u043F\u0440\u0438\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443 \u0437\u0440\u0438\u0442\u0435\u043B\u044E.
      \u0415\u0433\u043E {icon:subs} \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442\u0441\u044F,
      \u0438 \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0437\u0434\u0435\u0441\u044C,
      \u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u044B\u0433\u043D\u0430\u0442\u044C.
      \u0415\u0441\u043B\u0438 \u0435\u0433\u043E \u0432\u044B\u043D\u0443\u0434\u044F\u0442
      \u0443\u0439\u0442\u0438, \u043E\u043D\u0430 \u0443\u0439\u0434\u0451\u0442
      \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 504578082
    m_Localized: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430-\u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0430"
