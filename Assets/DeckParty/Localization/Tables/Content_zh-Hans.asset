    m_Localized: "\u6240\u6709\u52A8\u7269\u6897\u9F50\u805A\u4E00\u5802\u3002\u6572\u9F13\u732B\u5F3A\u5316\u6574\u4E2A\u52A8\u7269\u56ED\uFF0C\u5F69\u8679\u732B\u4E32\u8054\u8FDB\u573A\uFF0C\u795E\u70E6\u72D7\u5956\u52B1\u591A\u6837\u6027\uFF0C\u5927\u80D6\u5154\u9700\u8981\u5F88\u9AD8\u7684\u4EBA\u6570\u4E0A\u9650\u3002"
