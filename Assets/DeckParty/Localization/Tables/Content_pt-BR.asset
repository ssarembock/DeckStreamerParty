  m_Name: Content_pt-BR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: fe08c675884f17142aef311dafa6f47f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 370360320
    m_Localized: Primeira live
    m_Metadata:
      m_Items: []
  - m_Id: 433274880
    m_Localized: "Aprenda o b\xE1sico"
    m_Metadata:
      m_Items: []
  - m_Id: 433274881
    m_Localized: "Sua primeira temporada ao vivo. Regulares confi\xE1veis, Produtor
      e Admin do chat cuidando da sala, um colaborador arriscado e tr\xEAs Plays
      amig\xE1veis."
    m_Metadata:
      m_Items: []
  - m_Id: 433274882
    m_Localized: "F\xE3-clube"
    m_Metadata:
      m_Items: []
  - m_Id: 433274883
    m_Localized: Lealdade compensa
    m_Metadata:
      m_Items: []
  - m_Id: 433274884
    m_Localized: "Monte uma verdadeira {icon:CoreFanbase} Base de f\xE3s: cada tr\xEAs
      regulares diferentes anulam 1 {icon:risk}, ent\xE3o trolls e orbitadores viram
      dinheiro garantido. Coelho maratonista e Ca\xE7ador de cupom amam um chat lotado."
    m_Metadata:
      m_Items: []
  - m_Id: 433274885
    m_Localized: Momento viral
    m_Metadata:
      m_Items: []
  - m_Id: 433274886
    m_Localized: "Ca\xE7ando fama"
    m_Metadata:
      m_Items: []
  - m_Id: 433274887
    m_Localized: "Colaboradores, esc\xE2ndalos e celebridades. {icon:Content} Conte\xFAdo
      faz os espectadores fora da sua base pontuarem duas vezes e {icon:Clout} Fama
      ainda d\xE1 {icon:subs} extras, mas o risco acumula r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 433274888
    m_Localized: "Laborat\xF3rio de memes"
    m_Metadata:
      m_Items: []
  - m_Id: 433274889
    m_Localized: Tanta sinergia
    m_Metadata:
      m_Items: []
  - m_Id: 433274890
    m_Localized: "A {icon:MemeticsDivision} Divis\xE3o Mem\xE9tica pode fazer a live
      inteira pontuar duas vezes. Cachorro Degen quer um chat cheio de comunidades
      diferentes e Gato Desolado lucra toda vez que algu\xE9m \xE9 expulso."
    m_Metadata:
      m_Items: []
  - m_Id: 433274891
    m_Localized: "Reuni\xE3o de equipe"
    m_Metadata:
      m_Items: []
  - m_Id: 433274892
    m_Localized: Tudo sob controle
    m_Metadata:
      m_Items: []
  - m_Id: 433274893
    m_Localized: "A equipe inteira na folha de pagamento. {icon:Staff} Equipe pode
      dispensar os pr\xF3prios custos de {icon:cash}, {icon:Techspertise} Tecnoexperts
      pode trazer de volta um servidor ca\xEDdo e cada a\xE7\xE3o p\xF5e o espectador
      certo pra dentro ou o errado pra fora."
    m_Metadata:
      m_Items: []
  - m_Id: 433274894
    m_Localized: "Mistura aleat\xF3ria"
    m_Metadata:
      m_Items: []
  - m_Id: 433274895
    m_Localized: Um elenco novo toda vez
    m_Metadata:
      m_Items: []
  - m_Id: 433274896
    m_Localized: "Onze espectadores aleat\xF3rios e tr\xEAs Plays aleat\xF3rios.
      Ven\xE7a cinco seguidas pra ganhar a Cereja."
    m_Metadata:
      m_Items: []
  - m_Id: 433274897
    m_Localized: Lobby aberto
    m_Metadata:
      m_Items: []
  - m_Id: 433274898
    m_Localized: "Todo mundo \xE9 bem-vindo (sandbox)"
    m_Metadata:
      m_Items: []
  - m_Id: 433274899
    m_Localized: "Todos os espectadores recrut\xE1veis est\xE3o na loja. \xD3timo
      pra experimentar; n\xE3o conta pro progresso."
    m_Metadata:
      m_Items: []
  - m_Id: 433274900
    m_Localized: Setup no quarto
    m_Metadata:
      m_Items: []
  - m_Id: 433274901
    m_Localized: "Fitas RGB, um ring light e uma cama que com certeza aparece no
      v\xEDdeo."
    m_Metadata:
      m_Items: []
  - m_Id: 433274902
    m_Localized: Live IRL na praia
    m_Metadata:
      m_Items: []
  - m_Id: 433274903
    m_Localized: "P\xF4r do sol, gaivotas e um celular num pau de selfie."
    m_Metadata:
      m_Items: []
  - m_Id: 433274904
    m_Localized: Cidade Neon IRL
    m_Metadata:
      m_Items: []
  - m_Id: 433274905
    m_Localized: "Fazendo live de um terra\xE7o. O horizonte brilha. O chat tamb\xE9m."
    m_Metadata:
      m_Items: []
  - m_Id: 433274906
    m_Localized: Casa de criadores
    m_Metadata:
      m_Items: []
  - m_Id: 433274907
    m_Localized: Dez criadores, uma cozinha, zero privacidade.
    m_Metadata:
      m_Items: []
  - m_Id: 433274908
    m_Localized: "Live amaldi\xE7oada das 3h"
    m_Metadata:
      m_Items: []
  - m_Id: 433274909
    m_Localized: "N\xE3o leia o chat. N\xE3o olhe pra tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 433274910
    m_Localized: Lounge do Metaverso
    m_Metadata:
      m_Items: []
  - m_Id: 433274911
    m_Localized: "Todo mundo \xE9 um torso flutuante. Ningu\xE9m tem pernas."
    m_Metadata:
      m_Items: []
  - m_Id: 433274912
    m_Localized: "Palco de est\xFAdio"
    m_Metadata:
      m_Items: []
  - m_Id: 433274913
    m_Localized: "Tela verde, m\xE1quina de fuma\xE7a, clipes lend\xE1rios."
    m_Metadata:
      m_Items: []
  - m_Id: 433274914
    m_Localized: Bunker do Debate
    m_Metadata:
      m_Items: []
  - m_Id: 433274915
    m_Localized: "Tr\xEAs monitores, duas discuss\xF5es e um microfone muito alto."
    m_Metadata:
      m_Items: []
  - m_Id: 433274916
    m_Localized: "Est\xFAdio de Podcast"
    m_Metadata:
      m_Items: []
  - m_Id: 433274917
    m_Localized: "Pain\xE9is de madeira, letreiro neon, carne seca de alce. Epis\xF3dio
      quatrocentos e vinte."
    m_Metadata:
      m_Items: []
  - m_Id: 433274918
    m_Localized: Dojo do Pro Gamer
    m_Metadata:
      m_Items: []
  - m_Id: 433274919
    m_Localized: "LEDs azuis, uma geladeira de energ\xE9tico e uma bandana num pedestal."
    m_Metadata:
      m_Items: []
  - m_Id: 433274920
    m_Localized: Sala dos Gritos
    m_Metadata:
      m_Items: []
  - m_Id: 433274921
    m_Localized: "Espuma ac\xFAstica, uma bola de futebol e alguma coisa pegando
      fogo."
    m_Metadata:
      m_Items: []
  - m_Id: 433274922
    m_Localized: "Galp\xE3o dos Sorteios"
    m_Metadata:
      m_Items: []
  - m_Id: 433274923
    m_Localized: "Paletes de dinheiro, um rel\xF3gio de contagem regressiva e muitos
      participantes bem nervosos."
    m_Metadata:
      m_Items: []
  - m_Id: 433274924
    m_Localized: "A Mans\xE3o (edi\xE7\xE3o socialista)"
    m_Metadata:
      m_Items: []
  - m_Id: 433274925
    m_Localized: "Uma sala de dois milh\xF5es de d\xF3lares com uma almofada de foice
      e martelo."
    m_Metadata:
      m_Items: []
  - m_Id: 433274926
    m_Localized: Academia dos Sentimentos
    m_Metadata:
      m_Items: []
  - m_Id: 433274927
    m_Localized: "Halteres, um saco de pancada e uma caixa de len\xE7os. Pro saco
      de pancada."
    m_Metadata:
      m_Items: []
  - m_Id: 433274928
    m_Localized: Arena do Tabuleiro
    m_Metadata:
      m_Items: []
  - m_Id: 433274929
    m_Localized: "Sessenta e quatro casas, duas cabe\xE7as e zero voz baixa."
    m_Metadata:
      m_Items: []
  - m_Id: 433274930
    m_Localized: Campina Pal
    m_Metadata:
      m_Items: []
  - m_Id: 433274931
    m_Localized: Colinas pastel, criaturas fofinhas e uma quantidade suspeita de
      esferas de captura.
    m_Metadata:
      m_Items: []
  - m_Id: 433274932
    m_Localized: Vazio do Quadro-negro
    m_Metadata:
      m_Items: []
  - m_Id: 433274933
    m_Localized: Uma tela escura infinita onde vetores giram suavemente.
    m_Metadata:
      m_Items: []
  - m_Id: 433274934
    m_Localized: "Arena do Clube dos Campe\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 433274935
    m_Localized: "Fuma\xE7a, lasers, um negatosc\xF3pio com raios X e um trof\xE9u
      enorme."
    m_Metadata:
      m_Items: []
  - m_Id: 416590601601024
    m_Localized: "Conflito de gera\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904192
    m_Localized: OK boomer
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904193
    m_Localized: '{icon:Boomer} Boomer paga em {icon:cash}, {icon:Millennial} Millennial
      em {icon:subs} e {icon:Zoomer} Zoomer joga os dados. Mestre da grana e Diretor
      de PR lucram com cada espectador arriscado no chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904194
    m_Localized: Inverno cripto
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904195
    m_Localized: Saque antes que despenque
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904196
    m_Localized: "{icon:FinanceBros} Finance Bros pode dobrar cada recompensa de
      {icon:cash}. D\xEA um rug pull com o Entusiasta de cripto, acumule cupons,
      fa\xE7a seu Gera\xE7\xE3o Z empregado crescer e deixe o Esc\xE2ndalo online
      lotar a sala."
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904197
    m_Localized: "Se\xE7\xE3o de coment\xE1rios"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904198
    m_Localized: "N\xE3o alimente os trolls"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904199
    m_Localized: "{icon:Trolls} Trolls paga mesmo quando voc\xEA \xE9 desplataformizado.
      Arrisque com o \xC1rbitro do chat de prontid\xE3o e, no multijogador, deixe
      os {icon:Bots} Bots de Clippo, o Lataria spammarem o pr\xF3ximo streamer."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
