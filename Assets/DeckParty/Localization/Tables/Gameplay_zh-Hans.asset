  - m_Id: 675190146285569
    m_Localized: "\u6BCF\u4F4D\u89C2\u4F17\u5C5E\u4E8E\u96F6\u4E2A\u3001\u4E00\u4E2A\u6216\u591A\u4E2A<b>\u793E\u7FA4</b>\uFF08\u5361\u7247\u4E0A\u7684\u5C0F\u56FE\u6807\uFF09\u3002\u76F4\u64AD\u95F4\u91CC\u6BCF\u4F4D<b>\u4E0D\u540C</b>\u7684\u89C2\u4F17\u7ED9\u81EA\u5DF1\u7684\u793E\u7FA4\u52A0
      1 \u70B9\uFF1B\u540C\u4E00\u5F20\u5361\u7684\u4E24\u4EFD\u53EA\u7B97\u4E00\u6B21\uFF0C\u89C2\u4F17\u79BB\u5F00\u65F6\u4E5F\u4F1A\u5E26\u8D70\u4ED6\u7684\u70B9\u6570\u3002\u70B9\u6570\u8D8A\u591A\uFF0C\u52A0\u6210\u8D8A\u5927\u3002\u7559\u610F\u76F4\u64AD\u95F4\u9876\u90E8\u7684<b>\u793E\u7FA4\u8282\u62CD</b>\uFF0C\u628A\u9F20\u6807\u79FB\u5230\u4EFB\u610F\u793E\u7FA4\u56FE\u6807\u4E0A\u5C31\u80FD\u770B\u5230\u5177\u4F53\u6548\u679C\uFF1A\\n{icon:CoreFanbase}
      <b>\u6838\u5FC3\u7C89\u4E1D</b>\uFF1A\u6BCF 3 \u70B9\u62B5\u6D88 1 {icon:risk}\u3002\\n{icon:Staff}
      <b>\u5DE5\u4F5C\u4EBA\u5458</b>\uFF1A\u6BCF\u70B9 10% \u51E0\u7387\u514D\u53BB\u5DE5\u4F5C\u4EBA\u5458\u7684
      {icon:cash} \u5F00\u9500\u3002\\n{icon:Content} <b>\u5185\u5BB9</b>\uFF1A\u6BCF\u70B9
      10% \u51E0\u7387\u8BA9\u975E\u6838\u5FC3\u7C89\u4E1D\u7684\u89C2\u4F17\u8BA1\u5206\u4E24\u6B21\u3002\\n{icon:Techspertise}
      <b>\u6280\u672F\u5B85</b>\uFF1A\u670D\u52A1\u5668\u5D29\u6E83\u65F6\u6709 20
      / 40 / 50% \u51E0\u7387\u4ECD\u7136\u8BA1\u5206\u3002\\n{icon:FinanceBros}
      <b>\u91D1\u878D\u54E5</b>\uFF1A\u6BCF\u70B9 10% \u51E0\u7387\u8BA9 {icon:cash}
      \u6536\u76CA\u7FFB\u500D\u3002\\n{icon:Trolls} <b>\u55B7\u5B50</b>\uFF1A\u88AB\u5C01\u53F7\u65F6\u6BCF\u70B9\u968F\u673A\u7ED9\u4F60
      1 {icon:subs} \u6216 {icon:cash}\u3002\\n{icon:Doomsdayers} <b>\u672B\u65E5\u515A</b>\uFF08\u591A\u4EBA\uFF09\uFF1A\u6BCF\u70B9
      4% \u51E0\u7387\u8BA9\u5BF9\u624B\u4E0B\u4E00\u573A\u76F4\u64AD\u7684\u6BCF\u4F4D\u89C2\u4F17\u4E0D\u8BA1\u5206\u3002\\n{icon:Boomer}
      <b>\u5A74\u513F\u6F6E\u4E00\u4EE3</b>\uFF1A\u8BA1\u5206\u65F6\u6BCF\u70B9 +2
      {icon:cash}\u3001-1 {icon:subs}\u3002\\n{icon:Millennial} <b>\u5343\u79A7\u4E00\u4EE3</b>\uFF1A\u8BA1\u5206\u65F6\u6BCF\u70B9
      +2 {icon:subs}\u3001-1 {icon:cash}\u3002\\n{icon:Zoomer} <b>Z\u4E16\u4EE3</b>\uFF1A\u5206\u522B\u63B7\u4E24\u6B21\uFF0C\u6BCF\u70B9
      20% \u51E0\u7387\uFF08\u6700\u9AD8 80%\uFF09\uFF1A+6 {icon:subs}\uFF0C\u4EE5\u53CA
      -3 {icon:cash}\u3002\\n{icon:ArmchairActivists} <b>\u952E\u76D8\u4FA0</b>\uFF1A\u6BCF\u70B9
      10% \u51E0\u7387\uFF08\u6700\u9AD8 50%\uFF09\u8BA9\u6BCF\u4F4D\u952E\u76D8\u4FA0\u4E0D\u8BA1\u5206\u3002\\n{icon:Clout}
      <b>\u6D41\u91CF</b>\uFF1A\u6BCF\u70B9 10% \u51E0\u7387\uFF08\u6700\u9AD8 40%\uFF09\u8BA9\u6838\u5FC3\u7C89\u4E1D\u4EE5\u5916\u7684\u6BCF\u4F4D\u89C2\u4F17\u6BCF\u6B21\u8BA1\u5206\u591A\u5E26\u6765
      +1 {icon:subs}\u3002\\n{icon:MemeticsDivision} <b>\u8FF7\u56E0\u90E8</b>\uFF1A\u6BCF\u70B9
      1% \u51E0\u7387\uFF08\u6700\u9AD8 10%\uFF09\u8BA9\u6574\u573A\u76F4\u64AD\u8BA1\u5206\u4E24\u6B21\u3002\\n{icon:Bots}
      <b>\u673A\u5668\u4EBA\u519B\u56E2</b>\uFF08\u591A\u4EBA\uFF09\uFF1A\u76F4\u64AD\u8BA1\u5206\u65F6\uFF0C\u6BCF\u4F4D\u673A\u5668\u4EBA\u519B\u56E2\u89C2\u4F17\u6BCF\u70B9
      10% \u51E0\u7387\uFF08\u6700\u9AD8 40%\uFF09\u5F80\u4E0B\u4E00\u4F4D\u73A9\u5BB6\u7684\u4E0B\u4E00\u573A\u76F4\u64AD\u9001\u53BB\u4E00\u4E2A\u673A\u5668\u4EBA\uFF08\u5360\u4F4D\u7F6E\uFF0C\u4E0D\u8D5A\u94B1\uFF09\u3002"
    m_Metadata:
      m_Items: []
