  m_SharedData: {fileID: 11400000, guid: 4a63c487877c3a4418d58efd9ecfa0bd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 429080576
    m_Localized: "RAID EM VOC\xCA!"
    m_Metadata:
      m_Items: []
  - m_Id: 491995136
    m_Localized: TAXADO!
    m_Metadata:
      m_Items: []
  - m_Id: 496189440
    m_Localized: "{player} usou {power} em voc\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189441
    m_Localized: Sem streamer
    m_Metadata:
      m_Items: []
  - m_Id: 496189442
    m_Localized: "Regras cl\xE1ssicas"
    m_Metadata:
      m_Items: []
  - m_Id: 496189443
    m_Localized: Sem poder
    m_Metadata:
      m_Items: []
  - m_Id: 496189444
    m_Localized: "Jogue o modo cl\xE1ssico sem poder de streamer. Seu espa\xE7o de
      poder fica vazio."
    m_Metadata:
      m_Items: []
  - m_Id: 496189445
    m_Localized: "S\xF3 vim pela vibe."
    m_Metadata:
      m_Items: []
  - m_Id: 496189446
    m_Localized: "Aleat\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 496189447
    m_Localized: Deixa o chat decidir
    m_Metadata:
      m_Items: []
  - m_Id: 496189448
    m_Localized: "Um streamer aleat\xF3rio \xE9 escolhido quando voc\xEA entra ao
      vivo."
    m_Metadata:
      m_Items: []
  - m_Id: 496189449
    m_Localized: Fate
    m_Metadata:
      m_Items: []
  - m_Id: 496189450
    m_Localized: O Lorde do Debate
    m_Metadata:
      m_Items: []
  - m_Id: 496189451
    m_Localized: Raid
    m_Metadata:
      m_Items: []
  - m_Id: 496189452
    m_Localized: "Escolha um rival: a pr\xF3xima live dele come\xE7a com +1 {icon:risk}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189453
    m_Localized: Debate comigo, mano.
    m_Metadata:
      m_Items: []
  - m_Id: 496189454
    m_Localized: Bro Jogan
    m_Metadata:
      m_Items: []
  - m_Id: 496189455
    m_Localized: "O Podcaster de Tr\xEAs Horas"
    m_Metadata:
      m_Items: []
  - m_Id: 496189456
    m_Localized: "Epis\xF3dio de tr\xEAs horas"
    m_Metadata:
      m_Items: []
  - m_Id: 496189457
    m_Localized: 'Passivo: comece com +1 de limite do chat. Aumentos de limite custam
      1 {icon:cash} a mais.'
    m_Metadata:
      m_Items: []
  - m_Id: 496189458
    m_Localized: "Jamie, puxa isso a\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 496189459
    m_Localized: Shinobi
    m_Metadata:
      m_Items: []
  - m_Id: 496189460
    m_Localized: A Lenda da Bandana
    m_Metadata:
      m_Items: []
  - m_Id: 496189461
    m_Localized: "Bomba de fuma\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 496189462
    m_Localized: "Sua pr\xF3xima live ignora 1 {icon:risk}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189463
    m_Localized: "Voc\xEA n\xE3o viu nada. Ningu\xE9m viu."
    m_Metadata:
      m_Items: []
  - m_Id: 496189464
    m_Localized: IRunFast
    m_Metadata:
      m_Items: []
  - m_Id: 496189465
    m_Localized: A Sirene Humana
    m_Metadata:
      m_Items: []
  - m_Id: 496189466
    m_Localized: Latir pro chat
    m_Metadata:
      m_Items: []
  - m_Id: 496189467
    m_Localized: 'Passivo: espectadores com {icon:risk} ganham +1 {icon:subs}.'
    m_Metadata:
      m_Items: []
  - m_Id: 496189468
    m_Localized: SIUUUUUUU!
    m_Metadata:
      m_Items: []
  - m_Id: 496189469
    m_Localized: MrShark
    m_Metadata:
      m_Items: []
  - m_Id: 496189470
    m_Localized: O Rei dos Sorteios
    m_Metadata:
      m_Items: []
  - m_Id: 496189471
    m_Localized: Sorteio de $10.000
    m_Metadata:
      m_Items: []
  - m_Id: 496189472
    m_Localized: "Na sua pr\xF3xima live, cada espectador ganha +1 {icon:subs}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189473
    m_Localized: "O \xFAltimo a sair do chat ganha!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189474
    m_Localized: "F**kboy \xC9tico"
    m_Metadata:
      m_Items: []
  - m_Id: 496189475
    m_Localized: "O Socialista de Mans\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 496189476
    m_Localized: Imposto sobre fortunas
    m_Metadata:
      m_Items: []
  - m_Id: 496189477
    m_Localized: "O rival mais rico te paga at\xE9 2 {icon:cash}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189478
    m_Localized: Comam os ricos. Menos eu, claro.
    m_Metadata:
      m_Items: []
  - m_Id: 496189479
    m_Localized: Sr. Corpo Duro Molenga
    m_Metadata:
      m_Items: []
  - m_Id: 496189480
    m_Localized: "Parece duro, \xE9 molenga"
    m_Metadata:
      m_Items: []
  - m_Id: 496189481
    m_Localized: Pouso suave
    m_Metadata:
      m_Items: []
  - m_Id: 496189482
    m_Localized: "Passivo: se sua live for desplataformizada, voc\xEA ainda fica
      com metade dos {icon:subs} dela."
    m_Metadata:
      m_Items: []
  - m_Id: 496189483
    m_Localized: REGENERADO. E um pouquinho molenga.
    m_Metadata:
      m_Items: []
  - m_Id: 496189484
    m_Localized: "Abomina\xE7\xE3o Estrat\xE9gica"
    m_Metadata:
      m_Items: []
  - m_Id: 496189485
    m_Localized: "Duas cabe\xE7as, zero calma"
    m_Metadata:
      m_Items: []
  - m_Id: 496189486
    m_Localized: Lance duplo
    m_Metadata:
      m_Items: []
  - m_Id: 496189487
    m_Localized: "Na sua pr\xF3xima live, a primeira a\xE7\xE3o de espectador que
      voc\xEA usar pode ser usada de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 496189488
    m_Localized: A torre! A TORRE!
    m_Metadata:
      m_Items: []
  - m_Id: 496189489
    m_Localized: Palmane
    m_Metadata:
      m_Items: []
  - m_Id: 496189490
    m_Localized: Temos que pegar (legalmente)
    m_Metadata:
      m_Items: []
  - m_Id: 496189491
    m_Localized: Esfera Pal
    m_Metadata:
      m_Items: []
  - m_Id: 496189492
    m_Localized: "Capture de gra\xE7a um espectador aleat\xF3rio da loja (custo 6
      ou menos, que n\xE3o seja Diamante)."
    m_Metadata:
      m_Items: []
  - m_Id: 496189493
    m_Localized: Oiii chat, quem quer ser meu pal?
    m_Metadata:
      m_Items: []
  - m_Id: 496189494
    m_Localized: Manim Maketh Man
    m_Metadata:
      m_Items: []
  - m_Id: 496189495
    m_Localized: "A Demonstra\xE7\xE3o Animada"
    m_Metadata:
      m_Items: []
  - m_Id: 496189496
    m_Localized: "Sequ\xEAncia bonita"
    m_Metadata:
      m_Items: []
  - m_Id: 496189497
    m_Localized: "Passivo: cada \xF3tima live seguida d\xE1 +1, +2, +3... {icon:subs}
      (m\xE1x. +5). Uma live fracassada zera a sequ\xEAncia."
    m_Metadata:
      m_Items: []
  - m_Id: 496189498
    m_Localized: Vamos visualizar isso.
    m_Metadata:
      m_Items: []
  - m_Id: 496189499
    m_Localized: Radiologista Grosso
    m_Metadata:
      m_Items: []
  - m_Id: 496189500
    m_Localized: "Bicampe\xE3o Consecutivo do Diagn\xF3stico"
    m_Metadata:
      m_Items: []
  - m_Id: 496189501
    m_Localized: "Vis\xE3o de raio X"
    m_Metadata:
      m_Items: []
  - m_Id: 496189502
    m_Localized: "Na sua pr\xF3xima live, voc\xEA v\xEA os pr\xF3ximos 3 espectadores
      da sua fila."
    m_Metadata:
      m_Items: []
  - m_Id: 496189503
    m_Localized: "Viol\xEAncia. Velocidade. Radiologia."
    m_Metadata:
      m_Items: []
  - m_Id: 496189504
    m_Localized: PASSIVO
    m_Metadata:
      m_Items: []
  - m_Id: 496189505
    m_Localized: ATIVO
    m_Metadata:
      m_Items: []
  - m_Id: 496189506
    m_Localized: "ATIVO \xB7 PR\xD3XIMA LIVE"
    m_Metadata:
      m_Items: []
  - m_Id: 496189507
    m_Localized: "ATIVO \xB7 RIVAL (MULTIJOGADOR)"
    m_Metadata:
      m_Items: []
  - m_Id: 496189508
    m_Localized: Custa {cost} (+{step} por uso)
    m_Metadata:
      m_Items: []
  - m_Id: 496189509
    m_Localized: Custa {cost}
    m_Metadata:
      m_Items: []
  - m_Id: 496189510
    m_Localized: 'Recarga: {count} {count:plural:turno|turnos}'
    m_Metadata:
      m_Items: []
  - m_Id: 496189511
    m_Localized: Uma vez por turno
    m_Metadata:
      m_Items: []
  - m_Id: 496189512
    m_Localized: ESCOLHA SEU STREAMER
    m_Metadata:
      m_Items: []
  - m_Id: 496189513
    m_Localized: Escolha quem vai ao vivo contra O ALGORITMO.
    m_Metadata:
      m_Items: []
  - m_Id: 496189514
    m_Localized: Escolha seu lutador. Quer dizer, streamer.
    m_Metadata:
      m_Items: []
  - m_Id: 496189515
    m_Localized: VS
    m_Metadata:
      m_Items: []
  - m_Id: 496189516
    m_Localized: O ALGORITMO
    m_Metadata:
      m_Items: []
  - m_Id: 496189517
    m_Localized: "Invicto. Incognosc\xEDvel. Impul\xE1vel."
    m_Metadata:
      m_Items: []
  - m_Id: 496189518
    m_Localized: UM DESAFIANTE SE APROXIMA
    m_Metadata:
      m_Items: []
  - m_Id: 496189519
    m_Localized: Seus rivais escolhem no lobby
    m_Metadata:
      m_Items: []
  - m_Id: 496189520
    m_Localized: AO VIVO!
    m_Metadata:
      m_Items: []
  - m_Id: 496189521
    m_Localized: Voltar
    m_Metadata:
      m_Items: []
  - m_Id: 496189522
    m_Localized: PODER
    m_Metadata:
      m_Items: []
  - m_Id: 496189523
    m_Localized: '{streamer} ENTRA NA LIVE!'
    m_Metadata:
      m_Items: []
  - m_Id: 496189524
    m_Localized: "Poder de rival: n\xE3o faz nada no modo solo."
    m_Metadata:
      m_Items: []
  - m_Id: 496189525
    m_Localized: "Setas ou clique para escolher \xB7 Enter para entrar ao vivo \xB7
      Esc para voltar"
    m_Metadata:
      m_Items: []
  - m_Id: 496189526
    m_Localized: J1
    m_Metadata:
      m_Items: []
  - m_Id: 496189527
    m_Localized: 99
    m_Metadata:
      m_Items: []
  - m_Id: 496189528
    m_Localized: RIZZ
    m_Metadata:
      m_Items: []
  - m_Id: 496189529
    m_Localized: TRETA
    m_Metadata:
      m_Items: []
  - m_Id: 496189530
    m_Localized: AURA
    m_Metadata:
      m_Items: []
  - m_Id: 496189531
    m_Localized: COPIUM
    m_Metadata:
      m_Items: []
  - m_Id: 496189532
    m_Localized: Poder do streamer
    m_Metadata:
      m_Items: []
  - m_Id: 496189533
    m_Localized: Usar ({cost})
    m_Metadata:
      m_Items: []
  - m_Id: 496189534
    m_Localized: Pronto
    m_Metadata:
      m_Items: []
  - m_Id: 496189535
    m_Localized: 'Recarregando: {count} {count:plural:turno|turnos}'
    m_Metadata:
      m_Items: []
  - m_Id: 496189536
    m_Localized: "Pronto para a sua pr\xF3xima live"
    m_Metadata:
      m_Items: []
  - m_Id: 496189537
    m_Localized: Sempre ativo
    m_Metadata:
      m_Items: []
  - m_Id: 496189538
    m_Localized: Sem poder de streamer
    m_Metadata:
      m_Items: []
  - m_Id: 496189539
    m_Localized: '{power}: escolha um rival'
    m_Metadata:
      m_Items: []
  - m_Id: 496189540
    m_Localized: Escolha o rival que vai levar.
    m_Metadata:
      m_Items: []
  - m_Id: 496189541
    m_Localized: '{player} ({cash} {icon:cash})'
    m_Metadata:
      m_Items: []
  - m_Id: 496189542
    m_Localized: "Precisa de um rival (s\xF3 multijogador)"
    m_Metadata:
      m_Items: []
  - m_Id: 496189543
    m_Localized: '{player} usou {power}!'
    m_Metadata:
      m_Items: []
  - m_Id: 496189544
    m_Localized: "RAIO X: PR\xD3XIMOS DA FILA"
    m_Metadata:
      m_Items: []
  - m_Id: 496189545
    m_Localized: "MAIS UM E A GENTE \xC9 DESPLATAFORMIZADO!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189546
    m_Localized: "{streamer} est\xE1 suando frio..."
    m_Metadata:
      m_Items: []
