    m_Metadata:
      m_Items: []
  - m_Id: 437469196
    m_Localized: "conferindo a Audi\xEAncia"
    m_Metadata:
      m_Items: []
  - m_Id: 437469197
    m_Localized: 'Sua vez: {seconds} s'
    m_Metadata:
      m_Items: []
  - m_Id: 437469198
