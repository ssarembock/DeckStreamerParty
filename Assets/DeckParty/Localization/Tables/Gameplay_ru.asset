  - m_Id: 675190146285568
    m_Localized: "\u0421\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 675190146285569
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
      \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0432 \u043D\u0443\u043B\u0435,
      \u043E\u0434\u043D\u043E\u043C \u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      <b>\u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445</b> (\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0437\u043D\u0430\u0447\u043A\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435).
      \u041A\u0430\u0436\u0434\u044B\u0439 <b>\u0440\u0430\u0437\u043D\u044B\u0439</b>
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0432 \u0447\u0430\u0442\u0435
      \u0434\u0430\u0451\u0442 \u0441\u0432\u043E\u0435\u043C\u0443 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0443
      \u043E\u0447\u043A\u043E; \u0434\u0432\u0435 \u043A\u043E\u043F\u0438\u0438
      \u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u044B \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u0430 \u0443\u0448\u0435\u0434\u0448\u0438\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u043E\u0451 \u043E\u0447\u043A\u043E. \u041A\u0430\u0436\u0434\u043E\u0435
      \u043E\u0447\u043A\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0431\u043E\u043D\u0443\u0441. \u0421\u043B\u0435\u0434\u0438\u0442\u0435
      \u0437\u0430 <b>\u0440\u0438\u0442\u043C\u043E\u043C \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432</b>
      \u0432\u0432\u0435\u0440\u0445\u0443 \u0447\u0430\u0442\u0430 \u0438 \u043D\u0430\u0432\u043E\u0434\u0438\u0442\u0435
      \u043D\u0430 \u0437\u043D\u0430\u0447\u043E\u043A \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E
      \u043E\u043D\u043E \u0434\u0435\u043B\u0430\u0435\u0442:\\n{icon:CoreFanbase}
      <b>\u042F\u0434\u0440\u043E \u0444\u0430\u043D\u0430\u0442\u043E\u0432</b>:
      \u043A\u0430\u0436\u0434\u044B\u0435 3 \u043E\u0447\u043A\u0430 \u0433\u0430\u0441\u044F\u0442
      1 {icon:risk}.\\n{icon:Staff} <b>\u041A\u043E\u043C\u0430\u043D\u0434\u0430</b>:
      10% \u0437\u0430 \u043E\u0447\u043A\u043E, \u0447\u0442\u043E {icon:cash} \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0438\u0437 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u043D\u0435 \u0441\u043F\u0438\u0448\u0435\u0442\u0441\u044F.\\n{icon:Content}
      <b>\u041A\u043E\u043D\u0442\u0435\u043D\u0442</b>: 10% \u0437\u0430 \u043E\u0447\u043A\u043E,
      \u0447\u0442\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u043D\u0435
      \u0438\u0437 \u044F\u0434\u0440\u0430 \u0444\u0430\u043D\u0430\u0442\u043E\u0432
      \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0434\u0432\u0430\u0436\u0434\u044B.\\n{icon:Techspertise}
      <b>\u0422\u0435\u0445\u043D\u0430\u0440\u0438</b>: 20 / 40 / 50%, \u0447\u0442\u043E
      \u0441\u0442\u0440\u0438\u043C \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0443\u043F\u0430\u043B
      \u0441\u0435\u0440\u0432\u0435\u0440.\\n{icon:FinanceBros} <b>\u0424\u0438\u043D\u0430\u043D\u0441\u0431\u0440\u043E</b>:
      10% \u0437\u0430 \u043E\u0447\u043A\u043E, \u0447\u0442\u043E {icon:cash} \u0443\u0434\u0432\u043E\u0438\u0442\u0441\u044F.\\n{icon:Trolls}
      <b>\u0422\u0440\u043E\u043B\u043B\u0438</b>: 1 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439
      {icon:subs} \u0438\u043B\u0438 {icon:cash} \u0437\u0430 \u043E\u0447\u043A\u043E
      \u043F\u0440\u0438 \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433\u0435.\\n{icon:Doomsdayers}
      <b>\u0410\u043F\u043E\u043A\u0430\u043B\u0438\u043F\u0442\u0438\u043A\u0438</b>
      (\u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0435\u0440): 4% \u0437\u0430
      \u043E\u0447\u043A\u043E, \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0441\u0442\u0440\u0438\u043C\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442.\\n{icon:Boomer}
      <b>\u0411\u0443\u043C\u0435\u0440\u044B</b>: +2 {icon:cash} \u0438 -1 {icon:subs}
      \u0437\u0430 \u043E\u0447\u043A\u043E \u043F\u0440\u0438 \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435
      \u0441\u0442\u0440\u0438\u043C\u0430.\\n{icon:Millennial} <b>\u041C\u0438\u043B\u043B\u0435\u043D\u0438\u0430\u043B\u044B</b>:
      +2 {icon:subs} \u0438 -1 {icon:cash} \u0437\u0430 \u043E\u0447\u043A\u043E
      \u043F\u0440\u0438 \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435 \u0441\u0442\u0440\u0438\u043C\u0430.\\n{icon:Zoomer}
      <b>\u0417\u0443\u043C\u0435\u0440\u044B</b>: \u0434\u0432\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445
      \u0431\u0440\u043E\u0441\u043A\u0430 \u043F\u043E 20% \u0437\u0430 \u043E\u0447\u043A\u043E
      (\u0434\u043E 80%): +6 {icon:subs} \u0438 -3 {icon:cash}.\\n{icon:ArmchairActivists}
      <b>\u0414\u0438\u0432\u0430\u043D\u043D\u044B\u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0441\u0442\u044B</b>:
      10% \u0437\u0430 \u043E\u0447\u043A\u043E (\u0434\u043E 50%), \u0447\u0442\u043E
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0438\u0432\u0430\u043D\u043D\u044B\u0439
      \u0430\u043A\u0442\u0438\u0432\u0438\u0441\u0442 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442.\\n{icon:Clout}
      <b>\u0425\u0430\u0439\u043F</b>: 10% \u0437\u0430 \u043E\u0447\u043A\u043E
      (\u0434\u043E 40%), \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0432\u043D\u0435 \u042F\u0434\u0440\u0430
      \u0444\u0430\u043D\u0430\u0442\u043E\u0432 \u043F\u0440\u0438 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442
      \u0435\u0449\u0451 +1 {icon:subs}.\\n{icon:MemeticsDivision} <b>\u041E\u0442\u0434\u0435\u043B
      \u043C\u0435\u043C\u043E\u043B\u043E\u0433\u0438\u0438</b>: 1% \u0437\u0430
      \u043E\u0447\u043A\u043E (\u0434\u043E 10%), \u0447\u0442\u043E \u0432\u0435\u0441\u044C
      \u0441\u0442\u0440\u0438\u043C \u043F\u043E\u0434\u0441\u0447\u0438\u0442\u0430\u044E\u0442
      \u0434\u0432\u0430\u0436\u0434\u044B.\\n{icon:Bots} <b>\u0411\u043E\u0442\u044B</b>
      (\u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0435\u0440): \u043F\u0440\u0438
      \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435 \u0441\u0442\u0440\u0438\u043C\u0430
      10% \u0437\u0430 \u043E\u0447\u043A\u043E (\u0434\u043E 40%) \u0434\u043B\u044F
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F-\u0431\u043E\u0442\u0430
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0411\u043E\u0442\u0430
      (\u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E,
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442)
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0441\u0442\u0440\u0438\u043C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
