    m_Metadata:
      m_Items: []
  - m_Id: 675190142091283
    m_Localized: "\u041C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0435\u0440.
      \u041F\u043E\u0441\u043B\u0435 \u0432\u0430\u0448\u0435\u0433\u043E \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
      \u0441\u0442\u0440\u0438\u043C\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u043E\u0447\u043A\u043E
      \u0434\u0430\u0451\u0442 \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0437\u0440\u0438\u0442\u0435\u043B\u044E
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0441\u0442\u0440\u0438\u043C\u0435
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432 {per}% \u0448\u0430\u043D\u0441
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
      ({top}% \u043F\u0440\u0438 {max} \u043E\u0447\u043A\u0430\u0445)."
    m_Metadata:
      m_Items: []
  - m_Id: 675190142091284
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441: {value}% \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0441\u0442\u0440\u0438\u043C\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432."
