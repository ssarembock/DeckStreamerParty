  - m_Id: 483606626
    m_Localized: "\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u043D\u0435\u043A\u043E\u0433\u043E
      \u043F\u043E\u0439\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 483606627
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0435\u0449\u0451 \u0432 \u0441\u0435\u0437\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 483606628
    m_Localized: "\u0423 \u044D\u0442\u043E\u0433\u043E \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430
      \u043D\u0435\u0442 {icon:cash} \u0434\u043B\u044F \u043D\u0430\u043B\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 483606629
    m_Localized: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      (\u0441\u0446\u0435\u043D\u0430 \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 483606630
    m_Localized: "\u042D\u0432\u043E\u043B\u044E\u0446\u0438\u044F (\u0440\u0430\u0441\u0442\u0451\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043B\u0438\u043C\u0438\u0442\u043E\u043C)"
    m_Metadata:
      m_Items: []
  - m_Id: 483606631
    m_Localized: "\u0426\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 483606632
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043E\u0434\u0438\u043D
      \u0441\u0442\u0440\u0438\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      <b>4 \u0437\u0440\u0438\u0442\u0435\u043B\u044F-\u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0432
      \u0447\u0430\u0442\u0435</b>, \u0438 \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0435\u0433\u043E \u0434\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043D\u043E\u0447\u0438
      (\u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E 25-\u0439).
      \u041D\u0430\u043D\u044F\u0442\u044C \u0447\u0435\u0442\u044B\u0440\u0451\u0445
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432 \u043C\u0430\u043B\u043E:
      \u043E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0440\u0438\u0439\u0442\u0438
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 483606633
    m_Localized: "\u041D\u043E\u0447\u044C \u0441\u043E\u0441\u0442\u043E\u0438\u0442
      \u0438\u0437 \u0434\u0432\u0443\u0445 \u0447\u0430\u0441\u0442\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 483606634
    m_Localized: "<b>1. \u0421\u0442\u0440\u0438\u043C.</b> \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      <b>\u0412\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0432 \u0447\u0430\u0442</b>, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0438\u0437 \u0432\u0430\u0448\u0435\u0439
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438 \u0437\u0430\u0448\u0451\u043B.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
      \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u043E\u0434\u0438\u043D \u0440\u0430\u0437
      \u0437\u0430 \u0441\u0442\u0440\u0438\u043C. \u0417\u0440\u0438\u0442\u0435\u043B\u0438
      \u0441 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      <b>\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F</b> \u043C\u043E\u0433\u0443\u0442
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0435\u0451
      \u0440\u0430\u0437 \u0437\u0430 \u0441\u0442\u0440\u0438\u043C. \u041A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0451 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442,
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 <b>\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0442\u0440\u0438\u043C</b> \u0438 \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
      \u0437\u0440\u0438\u0442\u0435\u043B\u0438 \u0432 \u0447\u0430\u0442\u0435.\\n<b>2.
      \u041C\u0430\u0433\u0430\u0437\u0438\u043D.</b> \u0417\u0440\u0438\u0442\u0435\u043B\u0438
      \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 {icon:subs}; \u043F\u043E\u0441\u043B\u0435
      \u0441\u0442\u0440\u0438\u043C\u0430 \u043E\u043D\u0438 \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F,
      \u0438 \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
      \u043D\u043E\u0432\u044B\u0435 \u0437\u0440\u0438\u0442\u0435\u043B\u0438.
      {icon:cash} \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442 <b>\u043B\u0438\u043C\u0438\u0442
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439</b> (\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439 \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0447\u0430\u0442\u0435 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E)."
    m_Metadata:
      m_Items: []
  - m_Id: 483606635
    m_Localized: "{icon:risk} \u0420\u0438\u0441\u043A \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 483606636
    m_Localized: "\u0417\u0440\u0438\u0442\u0435\u043B\u0438 \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C
      \u043A\u0440\u0435\u0441\u0442\u0438\u043A\u043E\u043C \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442
      {icon:risk}. \u0414\u043E 2 \u0447\u0438\u0441\u0442\u043E\u0433\u043E {icon:risk}
      \u2014 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E; \u043F\u0440\u0438
      <b>3 \u0441\u0442\u0440\u0438\u043C \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433</b>:
      \u043E\u043D \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0432\u044B\u043F\u043B\u0430\u0442\u044B, \u0438 \u0432\u044B
      \u0434\u0430\u0451\u0442\u0435 \u043E\u0434\u043D\u043E\u043C\u0443 \u0437\u0440\u0438\u0442\u0435\u043B\u044E
      <b>\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0431\u0430\u043D</b>
      (\u043E\u043D \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0441\u0442\u0440\u0438\u043C).
      \u041D\u043E\u0440\u043C\u0438\u0441, \u0424\u0430\u043D\u0430\u0442 \u0434\u043E
      \u0433\u0440\u043E\u0431\u0430 \u0438 \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u0437\u0432\u0435\u0437\u0434\u0430
      <b>\u0433\u0430\u0441\u044F\u0442</b> \u043F\u043E 1 {icon:risk}, \u043F\u043E\u043A\u0430
      \u0432 \u0447\u0430\u0442\u0435, \u043A\u0430\u043A \u0438 \u043A\u0430\u0436\u0434\u044B\u0435
      3 \u043E\u0447\u043A\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430
      {icon:CoreFanbase} \u042F\u0434\u0440\u043E \u0444\u0430\u043D\u0430\u0442\u043E\u0432.
      \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0440\u0438\u0442\u0435\u043B\u0438
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 {icon:risk} \u0441\u0432\u043E\u0438\u043C\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C\u0438; \u0410\u0440\u0431\u0438\u0442\u0440
      \u0447\u0430\u0442\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 483606637
    m_Localized: "\u041B\u0438\u043C\u0438\u0442 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 483606638
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043B\u0438\u043C\u0438\u0442 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442,
      \u0432\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
      \u043D\u0435\u043B\u044C\u0437\u044F, \u043D\u043E \u0442\u0435, \u043A\u0442\u043E
      <b>\u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442</b> \u0434\u0440\u0443\u0433\u0438\u0445
      (\u041C\u0430\u0440\u043A\u0435\u0442\u043E\u043B\u043E\u0433, \u041E\u043D\u043B\u0430\u0439\u043D-\u0441\u043A\u0430\u043D\u0434\u0430\u043B,
      \u0417\u0432\u0435\u0437\u0434\u0430 \u043F\u043E\u043A\u0440\u0443\u043F\u043D\u0435\u0435),
      \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0432\u0430\u0441
      \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B. \u0422\u043E\u0433\u0434\u0430
      <b>\u0441\u0435\u0440\u0432\u0435\u0440 \u043F\u0430\u0434\u0430\u0435\u0442</b>,
      \u0438 \u0441\u0442\u0440\u0438\u043C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0432\u044B\u043F\u043B\u0430\u0442\u044B. \u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435
      \u0437\u0430\u043F\u0430\u0441!"
    m_Metadata:
      m_Items: []
  - m_Id: 483606639
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 483606640
    m_Localized: "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u043B\u0438\u043C\u0438\u0442\u0430
      \u0441\u0442\u043E\u0438\u0442 2 {icon:cash}, \u0437\u0430\u0442\u0435\u043C
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043D\u0430 1 \u0431\u043E\u043B\u044C\u0448\u0435
      (\u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 12 \u0437\u0430 \u043C\u0435\u0441\u0442\u043E,
      \u043B\u0438\u043C\u0438\u0442 \u0434\u043E 34). \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0437\u0440\u0438\u0442\u0435\u043B\u0438 \u0431\u0435\u0440\u0443\u0442 \u0441\u0431\u043E\u0440\u044B
      (\u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      {icon:cash}). \u0421\u0431\u043E\u0440\u044B \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      {icon:cash}; \u043A\u0430\u0436\u0434\u0430\u044F \u043D\u0435\u043E\u043F\u043B\u0430\u0447\u0435\u043D\u043D\u0430\u044F
      \u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u0441\u0442\u043E\u0438\u0442 <b>7
      {icon:subs}</b>.\\n\u0417\u0430\u043F\u0430\u0441 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430
      <b>\u043E\u0431\u0449\u0438\u0439 \u0434\u043B\u044F \u0432\u0441\u0435\u0445
      \u0438\u0433\u0440\u043E\u043A\u043E\u0432</b>: \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      4 \u043A\u043E\u043F\u0438\u0438 \u043D\u0430 \u0432\u0435\u0441\u044C \u043C\u0430\u0442\u0447,
      \u0438 \u0443 \u0432\u0430\u0441 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 4 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445;
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432 \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0443\u0433\u043E\u0434\u043D\u043E. \u0423\u0431\u0440\u0430\u0442\u044C
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u0438\u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438
      \u043D\u0435\u043B\u044C\u0437\u044F, \u0442\u0430\u043A \u0447\u0442\u043E
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043D\u0430\u0451\u043C \u043C\u0435\u043D\u044F\u0435\u0442
      \u0432\u0430\u0448\u0438 \u0448\u0430\u043D\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 483606641
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0441\u0435\u043C\u044C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 483606642
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0435\u0441\u0442\u044C \u0442\u0438\u043F (\u0412\u0435\u0440\u0431\u043E\u0432\u043A\u0430,
      \u0418\u0437\u0433\u043D\u0430\u043D\u0438\u0435, \u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435,
      \u041F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430, \u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430,
      \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0430). \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043F\u0440\u043E\u0441\u044F\u0442
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u043B\u0438 \u0434\u0432\u0443\u0445 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439;
      \u0434\u043B\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \xAB\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C\xBB.
      \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
      (\u043F\u0440\u043E\u043C\u043E\u043A\u043E\u0434 \u041F\u0430\u0440\u0442\u043D\u0451\u0440\u0430,
      \u0417\u0443\u043C\u0435\u0440 \u0441 \u0440\u0430\u0431\u043E\u0442\u043E\u0439)
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
      \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u0443\u0440\u0441\u043E\u0440
      \u043D\u0430 \u0437\u0440\u0438\u0442\u0435\u043B\u044F, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
      \u0442\u0438\u043F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 483606643
    m_Localized: "\u0421\u0442\u0440\u0438\u043C\u0435\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 483606644
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0441\u0435\u0437\u043E\u043D\u043E\u043C
      \u0432\u044B <b>\u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0430</b>.
      \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0435\u0441\u0442\u044C
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C: <b>\u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0435</b>
      \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u0432\u0441\u0435\u0433\u0434\u0430;
      <b>\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435</b> \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u043F\u043E\u0441\u043B\u0435
      \u0441\u0442\u0440\u0438\u043C\u0430 (\u0432 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434),
      \u0441\u0442\u043E\u044F\u0442 {icon:cash}, \u0434\u043E\u0440\u043E\u0436\u0430\u044E\u0442
      \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      (\u043A\u0430\u043A \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
      \u043B\u0438\u043C\u0438\u0442\u0430) \u0438 \u043C\u043E\u0433\u0443\u0442
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438.
      \u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 <b>\u043F\u0440\u043E\u0442\u0438\u0432
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430</b> (\u0420\u0435\u0439\u0434,
      \u041D\u0430\u043B\u043E\u0433 \u043D\u0430 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u043E)
      \u0431\u044C\u044E\u0442 \u043F\u043E \u0434\u0440\u0443\u0433\u043E\u043C\u0443
      \u0438\u0433\u0440\u043E\u043A\u0443, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432 \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0435\u0440\u0435.
      \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 <b>\u0411\u0435\u0437 \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0430</b>,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0433\u0440\u0430\u0442\u044C \u043F\u043E
      \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C.
      \u0421\u0442\u0440\u0438\u043C\u0435\u0440 \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
      \u0441\u0432\u043E\u0451 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435
      \u0441\u0442\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 483606645
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 483606646
    m_Localized: "<b>\u041F\u0440\u043E\u0431\u0435\u043B</b> \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F / \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
      / \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u043D\u043E\u0447\u044C  
      <b>E</b> \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u0442\u0440\u0438\u043C  
      <b>R</b> \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F   <b>Esc</b>
      \u043E\u0442\u043C\u0435\u043D\u0430 / \u043C\u0435\u043D\u044E   <b>F11</b>
      \u043F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 483606647
    m_Localized: "\u041C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 483606648
    m_Localized: "\u0423 \u0432\u0441\u0435\u0445 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439
      \u0438 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F,
      \u0438 \u0432\u0441\u0435 \u043C\u043E\u0433\u0443\u0442 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043B\u044E\u0431\u043E\u0439 \u0441\u0442\u0440\u0438\u043C: \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u0432 \u043F\u0430\u043D\u0435\u043B\u0438
      \xAB\u0418\u0433\u0440\u043E\u043A\u0438\xBB, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E \u043F\u043E\u043B\u0435
      \u0432\u0436\u0438\u0432\u0443\u044E. \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
      <b>\u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438</b> (\u043F\u043E
      \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E) \u0438\u0433\u0440\u043E\u043A\u0438
      \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C \u0441\u0442\u0440\u0438\u043C\u044F\u0442
      \u0434\u0440\u0443\u0433 \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u043C,
      \u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u044F\u0442,
      \u043A\u0443\u0434\u0430 \u043E\u043D \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442 \u0438
      \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442; \u0441\u0435\u0437\u043E\u043D
      \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u043D\u043E\u0447\u0438, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0432\u0451\u043B \u0441\u0442\u0440\u0438\u043C
      \u0441 4 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430\u043C\u0438.
      \u0425\u043E\u0441\u0442 \u043C\u043E\u0436\u0435\u0442 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0442\u0430\u0439\u043C\u0435\u0440 \u0445\u043E\u0434\u0430. \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
      <b>\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u044B\u0435 \u043D\u043E\u0447\u0438</b>
      \u0432\u0441\u0435 \u0438\u0433\u0440\u0430\u044E\u0442 \u043E\u0434\u043D\u0443
      \u043D\u043E\u0447\u044C \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E,
      \u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u0433\u043E\u0442\u043E\u0432\u044B.
      \u0412 \u0440\u0435\u0436\u0438\u043C\u0435 <b>\u0413\u043E\u043D\u043A\u0430</b>
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0433\u0440\u0430\u0435\u0442 \u0432
      \u0441\u0432\u043E\u0451\u043C \u0442\u0435\u043C\u043F\u0435, \u0438 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0441\u0442\u0440\u0438\u043C \u0441 4 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430\u043C\u0438
      \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442.
      \u0415\u0441\u043B\u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0431\u0435\u0434\u0438\u043B,
      \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0438\u0439
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043F\u043E \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430\u043C
      \u0432 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C \u0441\u0442\u0440\u0438\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 483606649
    m_Localized: "<b>\u041F\u043E\u0431\u0435\u0434\u0430:</b> 4 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430
      \u0432 \u043E\u0434\u043D\u043E\u043C \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C
      \u0441\u0442\u0440\u0438\u043C\u0435.\\n<b>\u0417\u043D\u0430\u0447\u043A\u0438:</b>
      {icon:subs} \u0445\u0430\u0439\u043F   {icon:cash} \u0434\u0435\u043D\u044C\u0433\u0438  
      {icon:risk} \u0440\u0438\u0441\u043A \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433\u0430  
      {icon:plays} \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u044B (\u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
      \u043D\u0430 \u0437\u043D\u0430\u0447\u043E\u043A, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u044D\u0442\u043E).\\n<b>\u0412\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F:</b> \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u0438\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u0438
      \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0432 \u0447\u0430\u0442.  <b>\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0442\u0440\u0438\u043C:</b> \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      {icon:subs} \u0438 {icon:cash} \u0432\u0441\u0435\u0445 \u0432 \u0447\u0430\u0442\u0435.\\n<b>3
      \u0447\u0438\u0441\u0442\u043E\u0433\u043E {icon:risk}</b> = \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433
      (\u0431\u0435\u0437 \u0432\u044B\u043F\u043B\u0430\u0442\u044B, \u043E\u0434\u0438\u043D
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0431\u0430\u043D).\\n<b>\u0411\u043E\u043B\u044C\u0448\u0435
      \u043B\u0438\u043C\u0438\u0442\u0430</b> = \u0441\u0435\u0440\u0432\u0435\u0440
      \u043F\u0430\u0434\u0430\u0435\u0442 (\u0431\u0435\u0437 \u0432\u044B\u043F\u043B\u0430\u0442\u044B).\\n<b>\u0421\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430:</b>
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437\u043D\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
      \u0432 \u0447\u0430\u0442\u0435 \u0434\u0430\u0451\u0442 \u043E\u0447\u043A\u043E
      \u0441\u0432\u043E\u0435\u043C\u0443 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0443;
      \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0447\u043A\u043E\u0432,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0431\u043E\u043D\u0443\u0441
      (\u0440\u0438\u0442\u043C \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432
      \u0432\u0432\u0435\u0440\u0445\u0443 \u0447\u0430\u0442\u0430).\\n<b>\u041C\u0430\u0433\u0430\u0437\u0438\u043D:</b>
      {icon:subs} \u043D\u0430\u043D\u0438\u043C\u0430\u044E\u0442 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
      (\u0437\u0430\u043F\u0430\u0441 \u043E\u0431\u0449\u0438\u0439 \u0434\u043B\u044F
      \u0432\u0441\u0435\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432), {icon:cash}
      \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442 \u043B\u0438\u043C\u0438\u0442
      \u0438 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044E\u0442 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0430.\\n<b>\u041A\u043B\u0430\u0432\u0438\u0448\u0438:</b>
      \u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C/\u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C/\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u043D\u043E\u0447\u044C, E \u2014 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0442\u0440\u0438\u043C, R \u2014 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F,
      Esc \u2014 \u043C\u0435\u043D\u044E, F11 \u2014 \u043F\u043E\u043B\u043D\u044B\u0439
      \u044D\u043A\u0440\u0430\u043D."
