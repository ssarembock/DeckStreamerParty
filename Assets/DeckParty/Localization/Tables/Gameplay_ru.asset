    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441: {value}% \u0448\u0430\u043D\u0441,
      \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
