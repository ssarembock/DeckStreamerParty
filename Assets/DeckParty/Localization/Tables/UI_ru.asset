    m_Metadata:
      m_Items: []
  - m_Id: 1574125583
    m_Localized: "\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u044B {count}/{max}"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125584
    m_Localized: "<b>{icon:risk} \u0420\u0438\u0441\u043A \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433\u0430</b>\\n{max}
      \u0447\u0438\u0441\u0442\u043E\u0433\u043E {icon:risk} \u0437\u0430 \u0441\u0442\u0440\u0438\u043C
      \u2014 \u0438 \u0441\u0442\u0440\u0438\u043C \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125585
    m_Localized: "<b>{icon:risk} \u0420\u0438\u0441\u043A \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433\u0430</b>\\n\u041E\u0442
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439: {added}\\n\u041F\u043E\u0433\u0430\u0448\u0435\u043D\u043E:
