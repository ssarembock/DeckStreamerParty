    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u044F\u0442: {count}"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514333
    m_Localized: "<b>\u0420\u0430\u0434\u043E\u0441\u0442\u044C:</b> +3 {icon:subs}.  
      <b>\u0413\u0440\u0443\u0441\u0442\u044C:</b> +3 {icon:cash}.   <b>\u042F\u0440\u043E\u0441\u0442\u044C:</b>
      +6 {icon:subs} \u0438 +1 {icon:risk}.\\n\u0414\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0442\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514334
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 {subs} {icon:subs}
      \u0438\u043B\u0438 {cash} {icon:cash} \u0438\u0437 \u0431\u0430\u043D\u043A\u0430.
      \u0415\u0441\u043B\u0438 \u0441\u0442\u0440\u0438\u043C \u0443\u0434\u0430\u0441\u0442\u0441\u044F,
      \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u0432 {mult} \u0440\u0430\u0437\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435; \u0435\u0441\u043B\u0438 \u0441\u0442\u0440\u0438\u043C
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433
      \u0438\u043B\u0438 \u0443\u043F\u0430\u0434\u0451\u0442 \u0441\u0435\u0440\u0432\u0435\u0440
      \u2014 \u0432\u0441\u0451 \u043F\u0440\u043E\u043F\u0430\u043B\u043E.\\n\u0423
      \u0432\u0430\u0441 {have_subs} {icon:subs} \u0438 {have_cash} {icon:cash}."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514335
    m_Localized: "<b>\u041F\u0435\u0440\u0435\u0431\u0440\u043E\u0441:</b> {viewer}
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u044C,
      \u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
      \u043D\u043E\u0432\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514336
    m_Localized: "<b>\u041F\u0435\u0440\u0435\u0431\u0440\u043E\u0441:</b> \u0441\u0435\u0439\u0447\u0430\u0441
      \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0442\u044C
      \u043D\u0435\u043A\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514337
    m_Localized: "<b>\u041F\u043E\u0434\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C:</b>
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u0438 \u0440\u0435\u0448\u0438\u0442\u044C,
      \u0432\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043B\u0438 \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514338
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0435 \u0434\u0432\u0443\u0445
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439: \u043F\u0435\u0440\u0432\u044B\u0439
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
      \u0443 \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u0443\u0434\u0432\u043E\u044F\u0442\u0441\u044F
      \u0431\u0430\u0437\u043E\u0432\u044B\u0435 {icon:subs} \u0438\u043B\u0438 {icon:cash}.\\n\u0427\u0442\u043E
      \u0443\u0434\u0432\u043E\u0438\u0442\u044C \u0432\u0442\u043E\u0440\u043E\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514339
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0435 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F \u043D\u0430 \u044D\u0442\u0443
      \u043D\u043E\u0447\u044C.\\n<b>{icon:subs} \u0432 {icon:cash}:</b> \u043A\u0430\u0436\u0434\u044B\u0435
      2 {icon:subs} \u2014 1 {icon:cash}.   <b>{icon:cash} \u0432 {icon:subs}:</b>
      \u043A\u0430\u0436\u0434\u044B\u0439 1 {icon:cash} \u2014 2 {icon:subs}."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514340
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0438\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043F\u043E\u0437\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514341
    m_Localized: "\u042D\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0437\u0440\u0438\u0442\u0435\u043B\u0438 \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438.
      \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u043A\u043E\u043C\u0443
      \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0430 \u044D\u0442\u0443
      \u043D\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514342
    m_Localized: "\u041A\u0442\u043E \u0432\u043E\u0439\u0434\u0451\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514343
    m_Localized: "{viewer}: \u043D\u043E\u0432\u0430\u044F \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514344
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u043A\u043E\u0433\u043E
      \u043F\u043E\u0437\u0432\u0430\u0442\u044C, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u2014 \u043A\u043E\u0433\u043E \u043E\u043D \u0437\u0430\u043C\u0435\u043D\u0438\u0442.
      \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
