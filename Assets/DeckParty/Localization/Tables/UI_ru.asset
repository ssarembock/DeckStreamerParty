    m_Metadata:
      m_Items: []
  - m_Id: 1574125619
    m_Localized: "\u0423 \u0432\u0430\u0441 {subs} \u0438 {cash}"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125620
    m_Localized: "\u0423 {player}: {subs} \u0438 {cash}"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125621
    m_Localized: "\u042D\u0442\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D {player}.
      \u0412\u044B \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125622
    m_Localized: "\u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0441\u0432\u043E\u0435\u0433\u043E
      \u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125623
    m_Localized: "\u0412\u044B \u043E\u0442\u043C\u0435\u0442\u0438\u043B\u0438\u0441\u044C
      \u043A\u0430\u043A \u0433\u043E\u0442\u043E\u0432\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125624
    m_Localized: "\u041B\u0438\u043C\u0438\u0442 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
      \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125625
    m_Localized: "\u041F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u043B\u0438\u043C\u0438\u0442
      ({from} -> {to})  {cost}"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125626
    m_Localized: "\u0427\u0435\u043C \u0432\u044B\u0448\u0435 \u043B\u0438\u043C\u0438\u0442,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439
