  - m_Id: 1574125612
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125613
    m_Localized: "\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125614
    m_Localized: "\u041D\u0430\u0431\u043E\u0440 \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125615
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0437\u0440\u0438\u0442\u0435\u043B\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043D\u044F\u0442\u044C \u0435\u0433\u043E
      \u0432 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E \u043D\u0430
      \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0449\u0438\u0435 \u0441\u0442\u0440\u0438\u043C\u044B.
      \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u0443\u0440\u0441\u043E\u0440
      \u0434\u043B\u044F \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439.
      \u0417\u0430\u043F\u0430\u0441 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430
      \u043E\u0431\u0449\u0438\u0439 \u0434\u043B\u044F \u0432\u0441\u0435\u0445
      \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125616
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C {count} {count:plural:\u043D\u043E\u0447\u044C|\u043D\u043E\u0447\u0438|\u043D\u043E\u0447\u0435\u0439}."
