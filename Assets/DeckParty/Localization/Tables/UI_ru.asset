      m_Items: []
  - m_Id: 1574125617
    m_Localized: "\u041D\u043E\u0447\u044C {night} \u0438\u0437 {total} \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125618
    m_Localized: "\u041D\u043E\u0447\u044C {night} \u0438\u0437 {total} \u0443 {player}
