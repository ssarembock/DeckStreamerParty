  - m_Id: 1582514435
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0441\u0435\u0437\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514436
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514437
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0438\u043B\u0438 \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C
      \u0434\u0440\u0443\u0437\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514438
    m_Localized: "\u0412\u0441\u0435 \u0433\u043E\u0442\u043E\u0432\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 1582514439
    m_Localized: "\u0416\u0434\u0451\u043C, \u043F\u043E\u043A\u0430 \u0445\u043E\u0441\u0442
      \u043D\u0430\u0447\u043D\u0451\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514440
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0413\u043E\u0442\u043E\u0432\xBB,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514441
    m_Localized: "\u0432 \u043A\u0430\u0436\u0434\u043E\u043C \u0440\u0430\u0443\u043D\u0434\u0435
      \u0438\u0433\u0440\u043E\u043A\u0438 \u0441\u0442\u0440\u0438\u043C\u044F\u0442
      \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438, \u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0432\u0436\u0438\u0432\u0443\u044E.
      \u0421\u0435\u0437\u043E\u043D \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0443\u043D\u0434\u0430, \u0432
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043A\u0442\u043E-\u0442\u043E
      \u0441\u043E\u0431\u0440\u0430\u043B {count} \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514442
    m_Localized: "\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0432 \u0441\u0432\u043E\u0451\u043C
      \u0442\u0435\u043C\u043F\u0435. \u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u0442\u0440\u0438\u043C
      \u0441 {count} \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430\u043C\u0438
      \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442.
      \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514443
    m_Localized: "\u0432\u0441\u0435 \u0441\u0442\u0440\u0438\u043C\u044F\u0442 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E,
      \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0442
      \u0447\u0443\u0436\u0438\u0445 \u0441\u0442\u0440\u0438\u043C\u043E\u0432.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u0441\u0442\u0440\u0438\u043C\u044B
      \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u044B \u0438 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043D\u0430\u0436\u0430\u043B \xAB\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\xBB,
      \u043E\u0442\u0441\u0447\u0451\u0442 3-2-1 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0434\u043B\u044F \u0432\u0441\u0435\u0445
      \u0441\u0440\u0430\u0437\u0443: \u043A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439,
      \u0442\u043E\u0433\u043E \u0438 \u0442\u0430\u043F\u043A\u0438. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0443\u043D\u0434, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043A\u0442\u043E-\u0442\u043E \u0441\u043E\u0431\u0440\u0430\u043B {count}
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430, \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442
      \u0441\u0435\u0437\u043E\u043D. \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0440\u0435\u0436\u0438\u043C \u0434\u043B\u044F 3 \u0438 \u0431\u043E\u043B\u0435\u0435
      \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514444
    m_Localized: "{code} \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D
