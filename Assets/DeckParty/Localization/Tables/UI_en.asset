    m_Metadata:
      m_Items: []
  - m_Id: 1582514334
    m_Localized: Stake {subs} Gifted Subs or {cash} $ from your bank. If the stream
      succeeds you get {mult}x back; if it gets a Platform Ban or the server goes
      down, it's gone.\nYou have {have_subs} Gifted Subs and {have_cash} $.
    m_Metadata:
      m_Items: []
