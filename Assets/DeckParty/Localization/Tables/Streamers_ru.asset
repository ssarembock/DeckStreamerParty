  m_TableData:
  - m_Id: 429080576
    m_Localized: "\u0420\u0415\u0419\u0414!"
    m_Metadata:
      m_Items: []
  - m_Id: 491995136
    m_Localized: "\u041D\u0410\u041B\u041E\u0413!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189440
    m_Localized: "{player} \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442
      \u043A \u0432\u0430\u043C \xAB{power}\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189441
    m_Localized: "\u0411\u0435\u0437 \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189442
    m_Localized: "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189443
    m_Localized: "\u041D\u0435\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 496189444
    m_Localized: "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0438\u0433\u0440\u0430 \u0431\u0435\u0437 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0430. \u0421\u043B\u043E\u0442
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0443\u0441\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 496189445
    m_Localized: "\u042F \u0442\u0443\u0442 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430 \u0432\u0430\u0439\u0431\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 496189446
    m_Localized: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 496189447
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0440\u0435\u0448\u0438\u0442 \u0447\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 496189448
    m_Localized: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0441\u0442\u0440\u0438\u043C\u0435\u0440
      \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438
      \u0437\u0430\u043F\u0443\u0441\u043A\u0435 \u0441\u0442\u0440\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 496189449
    m_Localized: Fate
    m_Metadata:
      m_Items: []
  - m_Id: 496189450
    m_Localized: "\u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044C \u0434\u0435\u0431\u0430\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 496189451
    m_Localized: "\u0420\u0435\u0439\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 496189452
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430:
      \u0435\u0433\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0441\u0442\u0440\u0438\u043C
      \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u0441 +1 {icon:risk}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189453
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0434\u0435\u0431\u0430\u0442\u0438\u0440\u0443\u0435\u043C,
      \u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 496189454
    m_Localized: Bro Jogan
    m_Metadata:
      m_Items: []
  - m_Id: 496189455
    m_Localized: "\u0422\u0440\u0451\u0445\u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u043F\u043E\u0434\u043A\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 496189456
    m_Localized: "\u0422\u0440\u0451\u0445\u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u0432\u044B\u043F\u0443\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 496189457
    m_Localized: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u043E: \u043B\u0438\u043C\u0438\u0442
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435\u0439 +1 \u0441 \u0441\u0430\u043C\u043E\u0433\u043E
      \u043D\u0430\u0447\u0430\u043B\u0430. \u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
      \u043B\u0438\u043C\u0438\u0442\u0430 \u0441\u0442\u043E\u044F\u0442 \u043D\u0430
      1 {icon:cash} \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 496189458
    m_Localized: "\u0414\u0436\u0435\u0439\u043C\u0438, \u043D\u0430\u0439\u0434\u0438-\u043A\u0430
      \u044D\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 496189459
    m_Localized: Shinobi
    m_Metadata:
      m_Items: []
  - m_Id: 496189460
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u0432 \u043F\u043E\u0432\u044F\u0437\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 496189461
    m_Localized: "\u0414\u044B\u043C\u043E\u0432\u0430\u044F \u0448\u0430\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189462
    m_Localized: "\u0412\u0430\u0448 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0441\u0442\u0440\u0438\u043C \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442
      1 {icon:risk}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189463
    m_Localized: "\u0412\u044B \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 496189464
    m_Localized: IRunFast
    m_Metadata:
      m_Items: []
  - m_Id: 496189465
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A-\u0441\u0438\u0440\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189466
    m_Localized: "\u041D\u0430\u043E\u0440\u0430\u0442\u044C \u043D\u0430 \u0447\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 496189467
    m_Localized: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u043E: \u0437\u0440\u0438\u0442\u0435\u043B\u0438
      \u0441 {icon:risk} \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 +1 {icon:subs}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189468
    m_Localized: "\u0421\u0418\u0423\u0423\u0423\u0423\u0423\u0423\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189469
    m_Localized: MrShark
    m_Metadata:
      m_Items: []
  - m_Id: 496189470
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 496189471
    m_Localized: "\u0420\u043E\u0437\u044B\u0433\u0440\u044B\u0448 \u043D\u0430 10
      000 $"
    m_Metadata:
      m_Items: []
  - m_Id: 496189472
    m_Localized: "\u0412 \u0432\u0430\u0448\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0441\u0442\u0440\u0438\u043C\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0440\u0438\u0442\u0435\u043B\u044C
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 +1 {icon:subs}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189473
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439, \u043A\u0442\u043E
      \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437 \u0447\u0430\u0442\u0430,
      \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189474
    m_Localized: "\u042D\u0442\u0438\u0447\u043D\u044B\u0439 \u0424**\u043A\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 496189475
    m_Localized: "\u0421\u043E\u0446\u0438\u0430\u043B\u0438\u0441\u0442 \u0438\u0437
      \u043E\u0441\u043E\u0431\u043D\u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189476
    m_Localized: "\u041D\u0430\u043B\u043E\u0433 \u043D\u0430 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 496189477
    m_Localized: "\u0421\u0430\u043C\u044B\u0439 \u0431\u043E\u0433\u0430\u0442\u044B\u0439
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u043F\u043B\u0430\u0442\u0438\u0442
      \u0432\u0430\u043C \u0434\u043E 2 {icon:cash}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189478
    m_Localized: "\u0415\u0448\u044C\u0442\u0435 \u0431\u043E\u0433\u0430\u0442\u044B\u0445.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 496189479
    m_Localized: "\u041C\u044F\u0433\u043A\u0438\u0439 \u041A\u0430\u0447\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 496189480
    m_Localized: "\u0421 \u0432\u0438\u0434\u0443 \u0442\u0432\u0451\u0440\u0434\u044B\u0439,
      \u0432\u043D\u0443\u0442\u0440\u0438 \u043C\u044F\u0433\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 496189481
    m_Localized: "\u041C\u044F\u0433\u043A\u0430\u044F \u043F\u043E\u0441\u0430\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189482
    m_Localized: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u043E: \u0435\u0441\u043B\u0438
      \u0441\u0442\u0440\u0438\u043C \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433,
      \u0432\u044B \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0435
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0435\u0433\u043E {icon:subs}."
    m_Metadata:
      m_Items: []
  - m_Id: 496189483
    m_Localized: "\u0418\u0421\u041F\u0420\u0410\u0412\u0418\u041B\u0421\u042F. \u0418
      \u043D\u0435\u043C\u043D\u043E\u0436\u043A\u043E \u043C\u044F\u0433\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 496189484
    m_Localized: "\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0427\u0443\u0434\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 496189485
    m_Localized: "\u0414\u0432\u0435 \u0433\u043E\u043B\u043E\u0432\u044B, \u043D\u043E\u043B\u044C
      \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 496189486
    m_Localized: "\u0414\u0432\u043E\u0439\u043D\u043E\u0439 \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 496189487
    m_Localized: "\u0412 \u0432\u0430\u0448\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0441\u0442\u0440\u0438\u043C\u0435 \u043F\u0435\u0440\u0432\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
      \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 496189488
    m_Localized: "\u041B\u0430\u0434\u044C\u044F! \u041B\u0410\u0414\u042C\u042F!"
    m_Metadata:
      m_Items: []
  - m_Id: 496189489
    m_Localized: Palmane
    m_Metadata:
      m_Items: []
  - m_Id: 496189490
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u0439 \u0438\u0445 \u0432\u0441\u0435\u0445
      (\u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 496189491
    m_Localized: "\u041F\u0430\u043B-\u0441\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496189492
    m_Localized: "\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044F
      \u0438\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 (\u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      6 \u0438\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435, \u043D\u0435 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440)."
    m_Metadata:
      m_Items: []
  - m_Id: 496189493
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u0438\u043A\u0438, \u0447\u0430\u0442,
      \u043A\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043C\u043E\u0438\u043C \u043F\u0430\u043B\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 496189494
    m_Localized: Manim Maketh Man
    m_Metadata:
      m_Items: []
  - m_Id: 496189495
    m_Localized: "\u0410\u043D\u0438\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 496189496
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 496189497
    m_Localized: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u043E: \u043A\u0430\u0436\u0434\u044B\u0439
      \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0439 \u0441\u0442\u0440\u0438\u043C
      \u043F\u043E\u0434\u0440\u044F\u0434 \u0434\u0430\u0451\u0442 +1, +2, +3...
      {icon:subs} (\u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C +5). \u041F\u0440\u043E\u0432\u0430\u043B\u044C\u043D\u044B\u0439
      \u0441\u0442\u0440\u0438\u043C \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u0441\u0435\u0440\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 496189498
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u044D\u0442\u043E \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 496189499
    m_Localized: "\u0413\u0440\u0443\u0431\u044B\u0439 \u0420\u0435\u043D\u0442\u0433\u0435\u043D\u043E\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 496189500
    m_Localized: "\u0414\u0432\u0443\u043A\u0440\u0430\u0442\u043D\u044B\u0439 \u0447\u0435\u043C\u043F\u0438\u043E\u043D
