    m_Metadata:
      m_Items: []
  - m_Id: 1574125585
    m_Localized: "<b>Risco de banimento</b>\\nAdicionado por espectadores: {added}\\nAnulado:
      -{cancelled}\\nL\xEDquido: {net} (banimento com {max})"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125586
    m_Localized: 'Do raid de um rival: +{count}'
    m_Metadata:
      m_Items: []
  - m_Id: 1574125587
    m_Localized: "Bomba de fuma\xE7a: -{count}"
    m_Metadata:
      m_Items: []
  - m_Id: 1574125588
    m_Localized: "<b>Diamantes</b>\\nNesta live: {now}\\nNa sua Audi\xEAncia: {owned}\\nRecorde
