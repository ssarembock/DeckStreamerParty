    m_Metadata:
      m_Items: []
  - m_Id: 1582514324
    m_Localized: Minha live
    m_Metadata:
      m_Items: []
  - m_Id: 1582514325
    m_Localized: Sua live
    m_Metadata:
      m_Items: []
  - m_Id: 1582514326
    m_Localized: A live de {player}
    m_Metadata:
      m_Items: []
