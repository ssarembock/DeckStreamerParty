      m_Items: []
  - m_Id: 1574125592
    m_Localized: "Mais um de risco e a live \xE9 banida."
    m_Metadata:
      m_Items: []
  - m_Id: 1574125593
    m_Localized: "Voc\xEA bateu o limite do chat. Use a\xE7\xF5es ou encerre a live."
