    m_Metadata:
      m_Items: []
  - m_Id: 1582514314
    m_Localized: "{player} n\xE3o conseguiu pagar {cash} $ de taxas e perdeu {penalty}
      Subs de presente."
    m_Metadata:
      m_Items: []
  - m_Id: 1582514315
    m_Localized: "Esta live come\xE7a com +{count} de risco de banimento."
    m_Metadata:
      m_Items: []
