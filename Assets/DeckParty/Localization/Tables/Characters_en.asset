  - m_Id: 416591515959296
    m_Localized: Ineffective Troll
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262464
    m_Localized: Starting viewer only. Lots of noise, a little {icon:risk}.
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262465
    m_Localized: Producer
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262466
    m_Localized: 'Action: choose any viewer in the queue to join chat, if there''s
      room.'
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262467
    m_Localized: Shoutout
    m_Metadata:
      m_Items: []
  - m_Id: 416591587262468
    m_Localized: Chat Admin
    m_Metadata:
      m_Items: []
