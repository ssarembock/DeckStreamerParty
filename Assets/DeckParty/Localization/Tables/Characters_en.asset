    m_Localized: Platform Admin
    m_Metadata:
      m_Items: []
  - m_Id: 504578143
    m_Localized: 'DIAMOND. Action: kick one viewer for the rest of the stream (even
      itself).'
    m_Metadata:
      m_Items: []
  - m_Id: 504578144
    m_Localized: Ban Wave
    m_Metadata:
