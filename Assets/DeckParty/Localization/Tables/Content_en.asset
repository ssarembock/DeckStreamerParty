  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Content_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: fe08c675884f17142aef311dafa6f47f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 370360320
    m_Localized: First Stream
    m_Metadata:
      m_Items: []
  - m_Id: 433274880
    m_Localized: Learn the ropes
    m_Metadata:
      m_Items: []
  - m_Id: 433274881
    m_Localized: Your first season live. Dependable regulars, a Producer and a Chat
      Admin to run the room, one risky collaborator and three friendly Plays.
    m_Metadata:
      m_Items: []
  - m_Id: 433274882
    m_Localized: Fan Club
    m_Metadata:
      m_Items: []
  - m_Id: 433274883
    m_Localized: Loyalty pays
    m_Metadata:
      m_Items: []
  - m_Id: 433274884
    m_Localized: 'Build a real {icon:CoreFanbase} Core Fanbase: every three different
      regulars cancel a {icon:risk}, so trolls and orbiters become safe money. Binge
      Bunny and the Promo Code User love a packed chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 433274885
    m_Localized: Viral Moment
    m_Metadata:
      m_Items: []
  - m_Id: 433274886
    m_Localized: Clout chasing
    m_Metadata:
      m_Items: []
  - m_Id: 433274887
    m_Localized: Collaborators, scandals and celebrities. {icon:Content} Content
      makes viewers outside your fanbase score twice and {icon:Clout} Clout tops
      them up with extra {icon:subs}, but the risk piles up fast.
    m_Metadata:
      m_Items: []
  - m_Id: 433274888
    m_Localized: Meme Lab
    m_Metadata:
      m_Items: []
  - m_Id: 433274889
    m_Localized: Such synergy
    m_Metadata:
      m_Items: []
  - m_Id: 433274890
    m_Localized: The {icon:MemeticsDivision} Memetics Division might make the whole
      stream score twice. Degen Dog wants a chat full of different communities, and
      Distraught Cat cashes in every time someone gets kicked.
    m_Metadata:
      m_Items: []
  - m_Id: 433274891
    m_Localized: Staff Meeting
    m_Metadata:
      m_Items: []
  - m_Id: 433274892
    m_Localized: Run a tight ship
    m_Metadata:
      m_Items: []
  - m_Id: 433274893
    m_Localized: The whole team on payroll. {icon:Staff} Staff may waive their own
      {icon:cash} costs, {icon:Techspertise} Techspertise may bring a crashed server
      back, and every action gets the right viewer in or the wrong one out.
    m_Metadata:
      m_Items: []
  - m_Id: 433274894
    m_Localized: Random Mix
    m_Metadata:
      m_Items: []
  - m_Id: 433274895
    m_Localized: A fresh character set every time
    m_Metadata:
      m_Items: []
  - m_Id: 433274896
    m_Localized: Eleven random viewers and three random Plays. Win five in a row
      to earn the Cherry.
    m_Metadata:
      m_Items: []
  - m_Id: 433274897
    m_Localized: Open Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 433274898
    m_Localized: Everyone's welcome (sandbox)
    m_Metadata:
      m_Items: []
  - m_Id: 433274899
    m_Localized: Every recruitable viewer is in the shop. Great for experimenting;
      does not count toward progress.
    m_Metadata:
      m_Items: []
  - m_Id: 433274900
    m_Localized: Bedroom Setup
    m_Metadata:
      m_Items: []
  - m_Id: 433274901
    m_Localized: RGB strips, a ring light and a bed that's definitely in frame.
    m_Metadata:
      m_Items: []
  - m_Id: 433274902
    m_Localized: IRL Beach Stream
    m_Metadata:
      m_Items: []
  - m_Id: 433274903
    m_Localized: Sunset, seagulls and a phone on a selfie stick.
    m_Metadata:
      m_Items: []
  - m_Id: 433274904
    m_Localized: Neon City IRL
    m_Metadata:
      m_Items: []
  - m_Id: 433274905
    m_Localized: Streaming from a rooftop. The skyline glows. So does chat.
    m_Metadata:
      m_Items: []
  - m_Id: 433274906
    m_Localized: Content House
    m_Metadata:
      m_Items: []
  - m_Id: 433274907
    m_Localized: Ten creators, one kitchen, zero privacy.
    m_Metadata:
      m_Items: []
  - m_Id: 433274908
    m_Localized: Cursed 3AM Stream
    m_Metadata:
      m_Items: []
  - m_Id: 433274909
    m_Localized: Don't read the chat. Don't look behind you.
    m_Metadata:
      m_Items: []
  - m_Id: 433274910
    m_Localized: Metaverse Lounge
    m_Metadata:
      m_Items: []
  - m_Id: 433274911
    m_Localized: Everyone is a floating torso. Nobody has legs.
    m_Metadata:
      m_Items: []
  - m_Id: 433274912
    m_Localized: Studio Stage
    m_Metadata:
      m_Items: []
  - m_Id: 433274913
    m_Localized: Green screen, smoke machine, legendary clips.
    m_Metadata:
      m_Items: []
  - m_Id: 433274914
    m_Localized: Debate Bunker
    m_Metadata:
      m_Items: []
  - m_Id: 433274915
    m_Localized: Three monitors, two arguments, one very loud microphone.
    m_Metadata:
      m_Items: []
  - m_Id: 433274916
    m_Localized: Podcast Studio
    m_Metadata:
      m_Items: []
  - m_Id: 433274917
    m_Localized: Wood panels, neon sign, elk jerky. Episode four hundred and twenty.
    m_Metadata:
      m_Items: []
  - m_Id: 433274918
    m_Localized: Pro Gamer Dojo
    m_Metadata:
      m_Items: []
  - m_Id: 433274919
    m_Localized: Blue LEDs, an energy drink fridge and a headband on a pedestal.
    m_Metadata:
      m_Items: []
  - m_Id: 433274920
    m_Localized: Screaming Room
    m_Metadata:
      m_Items: []
  - m_Id: 433274921
    m_Localized: Acoustic foam, a football and something on fire.
    m_Metadata:
      m_Items: []
  - m_Id: 433274922
    m_Localized: Giveaway Warehouse
    m_Metadata:
      m_Items: []
  - m_Id: 433274923
    m_Localized: Pallets of cash, a countdown clock and a lot of very nervous contestants.
    m_Metadata:
      m_Items: []
  - m_Id: 433274924
    m_Localized: The Mansion (Socialist Edition)
    m_Metadata:
      m_Items: []
  - m_Id: 433274925
    m_Localized: A two-million-dollar living room with a hammer-and-sickle throw
      pillow.
    m_Metadata:
      m_Items: []
  - m_Id: 433274926
    m_Localized: Gym of Feelings
    m_Metadata:
      m_Items: []
  - m_Id: 433274927
    m_Localized: Dumbbells, a punching bag and a box of tissues. For the punching
      bag.
    m_Metadata:
      m_Items: []
  - m_Id: 433274928
    m_Localized: Chessboard Arena
    m_Metadata:
      m_Items: []
  - m_Id: 433274929
    m_Localized: Sixty-four squares, two heads and zero inside voices.
    m_Metadata:
      m_Items: []
  - m_Id: 433274930
    m_Localized: Pal Meadow
    m_Metadata:
      m_Items: []
  - m_Id: 433274931
    m_Localized: Pastel hills, fluffy creatures and a suspicious number of capture
      spheres.
    m_Metadata:
      m_Items: []
  - m_Id: 433274932
    m_Localized: Blackboard Void
    m_Metadata:
      m_Items: []
  - m_Id: 433274933
    m_Localized: An infinite dark canvas where vectors gently rotate.
    m_Metadata:
      m_Items: []
  - m_Id: 433274934
    m_Localized: Champions Club Arena
    m_Metadata:
      m_Items: []
  - m_Id: 433274935
    m_Localized: Smoke, lasers, a lightbox of X-rays and a very large trophy.
    m_Metadata:
      m_Items: []
  - m_Id: 416590601601024
    m_Localized: Generation Gap
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904192
    m_Localized: OK boomer
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904193
    m_Localized: '{icon:Boomer} Boomer pays in {icon:cash}, {icon:Millennial} Millennial
      in {icon:subs} and {icon:Zoomer} Zoomer rolls the dice. The Master of Currency
      and the Executive PR cash in on every risky viewer in chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904194
    m_Localized: Crypto Winter
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904195
    m_Localized: Cash out before it crashes
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904196
    m_Localized: '{icon:FinanceBros} Finance Bros may double every {icon:cash} reward.
      Rug pull with the Crypto Enthusiast, stack Checkout Codes, grow your Gen Z
      with Job and let the Online Scandal fill the room.'
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904197
    m_Localized: Comment Section
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904198
    m_Localized: Don't feed the trolls
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904199
    m_Localized: '{icon:Trolls} Trolls pay out even when you get deplatformed. Ride
      the risk with the Chat Arbitrator on standby, and in multiplayer let Clippo
      The Clanker''s {icon:Bots} Bots spam the next streamer.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
