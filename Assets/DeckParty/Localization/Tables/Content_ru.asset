    m_Metadata:
      m_Items: []
  - m_Id: 433274930
    m_Localized: "\u041B\u0443\u0433 \u043F\u0430\u043B\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 433274931
    m_Localized: "\u041F\u0430\u0441\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0445\u043E\u043B\u043C\u044B,
      \u043F\u0443\u0448\u0438\u0441\u0442\u044B\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u0438 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043C\u043D\u043E\u0433\u043E \u043B\u043E\u0432\u0447\u0438\u0445 \u0441\u0444\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 433274932
    m_Localized: "\u041F\u0443\u0441\u0442\u043E\u0442\u0430 \u0434\u043E\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 433274933
    m_Localized: "\u0411\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
      \u0442\u0451\u043C\u043D\u044B\u0439 \u0445\u043E\u043B\u0441\u0442, \u043D\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043F\u043B\u0430\u0432\u043D\u043E
      \u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432\u0435\u043A\u0442\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 433274934
    m_Localized: "\u0410\u0440\u0435\u043D\u0430 \u041A\u043B\u0443\u0431\u0430 \u0447\u0435\u043C\u043F\u0438\u043E\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 433274935
    m_Localized: "\u0414\u044B\u043C, \u043B\u0430\u0437\u0435\u0440\u044B, \u043D\u0435\u0433\u0430\u0442\u043E\u0441\u043A\u043E\u043F
      \u0441 \u0440\u0435\u043D\u0442\u0433\u0435\u043D\u043E\u0432\u0441\u043A\u0438\u043C\u0438
      \u0441\u043D\u0438\u043C\u043A\u0430\u043C\u0438 \u0438 \u043E\u0447\u0435\u043D\u044C
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0443\u0431\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 416590601601024
    m_Localized: "\u041A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904192
    m_Localized: "\u041E\u043A\u0435\u0439, \u0431\u0443\u043C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904193
    m_Localized: "{icon:Boomer} \u0411\u0443\u043C\u0435\u0440\u044B \u043F\u043B\u0430\u0442\u044F\u0442
      {icon:cash}, {icon:Millennial} \u041C\u0438\u043B\u043B\u0435\u043D\u0438\u0430\u043B\u044B
      \u2014 {icon:subs}, \u0430 {icon:Zoomer} \u0417\u0443\u043C\u0435\u0440\u044B
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u043A\u043E\u0441\u0442\u0438.
      \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044C \u0432\u0430\u043B\u044E\u0442\u044B
      \u0438 \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440 \u043F\u043E PR \u043D\u0430\u0436\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u043C
      \u0437\u0440\u0438\u0442\u0435\u043B\u0435 \u0432 \u0447\u0430\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904194
    m_Localized: "\u041A\u0440\u0438\u043F\u0442\u043E\u0437\u0438\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904195
    m_Localized: "\u0412\u044B\u0432\u043E\u0434\u0438, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0440\u0443\u0445\u043D\u0443\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904196
    m_Localized: "{icon:FinanceBros} \u0424\u0438\u043D\u0430\u043D\u0441\u0431\u0440\u043E
      \u043C\u043E\u0433\u0443\u0442 \u0443\u0434\u0432\u043E\u0438\u0442\u044C \u043B\u044E\u0431\u0443\u044E
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443 \u0432 {icon:cash}. \u0414\u0435\u043B\u0430\u0439\u0442\u0435
      \u0440\u0430\u0433\u043F\u0443\u043B \u0441 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
      \xAB\u041A\u0440\u0438\u043F\u0442\u043E\u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0441\u0442\xBB,
      \u043A\u043E\u043F\u0438\u0442\u0435 \u043F\u0440\u043E\u043C\u043E\u043A\u043E\u0434\u044B,
      \u0440\u0430\u0441\u0442\u0438\u0442\u0435 \xAB\u0417\u0443\u043C\u0435\u0440
      \u0441 \u0440\u0430\u0431\u043E\u0442\u043E\u0439\xBB, \u0438 \u043F\u0443\u0441\u0442\u044C
      \xAB\u041E\u043D\u043B\u0430\u0439\u043D-\u0441\u043A\u0430\u043D\u0434\u0430\u043B\xBB
      \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442 \u0437\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904197
    m_Localized: "\u041A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904198
    m_Localized: "\u041D\u0435 \u043A\u043E\u0440\u043C\u0438\u0442\u0435 \u0442\u0440\u043E\u043B\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 416590672904199
    m_Localized: "{icon:Trolls} \u0422\u0440\u043E\u043B\u043B\u0438 \u043F\u043B\u0430\u0442\u044F\u0442,
      \u0434\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430 \u0432\u0430\u0441
      \u0434\u0435\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044F\u0442. \u0420\u0438\u0441\u043A\u0443\u0439\u0442\u0435,
      \u0434\u0435\u0440\u0436\u0430 \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \xAB\u0410\u0440\u0431\u0438\u0442\u0440
      \u0447\u0430\u0442\u0430\xBB, \u0430 \u0432 \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0435\u0440\u0435
      \u043F\u0443\u0441\u0442\u044C {icon:Bots} \u0411\u043E\u0442\u044B \u043E\u0442
      \xAB\u041A\u043B\u0438\u043F\u043F\u043E-\u0416\u0435\u043B\u0435\u0437\u044F\u043A\u0430\xBB
      \u0441\u043F\u0430\u043C\u044F\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0441\u0442\u0440\u0438\u043C\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
